// PerumNet CRM — Phase 1 Foundation schema
// Dev: SQLite. Production: PostgreSQL (skema dijaga portable, tanpa fitur khusus SQLite).
// Catatan: enum tidak didukung Prisma+SQLite, sehingga nilai status/kode
// divalidasi di service layer melalui konstanta di src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity & RBAC ─────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String   @unique
  name               String
  phone              String?
  passwordHash       String
  // Struktur organisasi: staff -> supervisor -> owner.
  // Level menentukan siapa yang dapat mengisi step approval dinamis
  // (SUPERVISOR = supervisor divisi pengaju, OWNER = pemilik).
  level              String   @default("STAFF") // STAFF | SUPERVISOR | OWNER
  divisionId         String?
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  division         Division?         @relation(fields: [divisionId], references: [id])
  roles            UserRole[]
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[] @relation("Requester")
  approvalActions  ApprovalStep[]    @relation("Actor")

  campaignsPic     Campaign[]     @relation("CampaignPic")
  ownedLeads       Lead[]         @relation("LeadOwner")
  createdLeads     Lead[]         @relation("LeadCreator")
  leadActivities   LeadActivity[] @relation("ActivityUser")
  opportunities    Opportunity[]  @relation("OppCreator")
  surveysAssigned  Survey[]       @relation("SurveyTechnician")
  surveysCreated   Survey[]       @relation("SurveyCreator")
  quotations       Quotation[]    @relation("QuotationCreator")
  ownedCustomers   Customer[]     @relation("CustomerOwner")
  createdCustomers Customer[]     @relation("CustomerCreator")
  subscriptions    Subscription[] @relation("SubscriptionCreator")
  attachments      Attachment[]   @relation("AttachmentUploader")

  custodyLevels    CustodyLevel[]     @relation("CustodyLevels")
  txAsCustodian    StockTransaction[] @relation("TxCustodian")
  txCreated        StockTransaction[] @relation("TxCreator")
  txPosted         StockTransaction[] @relation("TxPoster")
  devicesInCustody SerializedDevice[] @relation("DeviceCustodian")
  deviceMovements  DeviceMovement[]   @relation("DeviceMover")
  woAsTechnician   WorkOrder[]        @relation("WoTechnician")
  woCreated        WorkOrder[]        @relation("WoCreator")
  woClosed         WorkOrder[]        @relation("WoCloser")
  materialUsages   MaterialUsage[]    @relation("MaterialUser")
  opnamesCreated   OpnameSession[]    @relation("OpnameCreator")

  cashClaims      CashTransaction[] @relation("CashClaimant")
  cashCreated     CashTransaction[] @relation("CashCreator")
  cashPosted      CashTransaction[] @relation("CashPoster")
  closingsCreated CashClosing[]     @relation("ClosingCreator")
  projectsManaged Project[]         @relation("ProjectManager")
  projectsClosed  Project[]         @relation("ProjectCloser")
  projectsCreated Project[]         @relation("ProjectCreator")

  sitesAsPic       NetworkSite[]        @relation("SitePic")
  netDevicesOwned  NetworkDevice[]      @relation("NetDeviceOwner")
  subnetsOwned     Subnet[]             @relation("SubnetOwner")
  ipsCreated       IPAddress[]          @relation("IpCreator")
  alarmsAcked      NetworkAlarm[]       @relation("AlarmAck")
  alarmsCreated    NetworkAlarm[]       @relation("AlarmCreator")
  incidentsAsPic   Incident[]           @relation("IncidentPic")
  incidentsCreated Incident[]           @relation("IncidentCreator")
  incidentUpdates  IncidentUpdate[]     @relation("IncidentUpdater")
  maintAsPic       NetworkMaintenance[] @relation("MaintPic")
  maintCreated     NetworkMaintenance[] @relation("MaintCreator")
  changesAsPic     ChangeRequest[]      @relation("ChangePic")
  changesExecuted  ChangeRequest[]      @relation("ChangeExecutor")
  changesReviewed  ChangeRequest[]      @relation("ChangeReviewer")
  changesCreated   ChangeRequest[]      @relation("ChangeCreator")

  serversOwned     Server[]        @relation("ServerOwner")
  appsOwned        Application[]   @relation("AppOwner")
  appsBusinessOwn  Application[]   @relation("AppBusinessOwner")
  ticketsRequested ItTicket[]      @relation("TicketRequester")
  ticketsAssigned  ItTicket[]      @relation("TicketAssignee")
  ticketsCreated   ItTicket[]      @relation("TicketCreator")
  accessAsTarget   AccessRequest[] @relation("AccessTarget")
  accessGranted    AccessRequest[] @relation("AccessGrantor")
  accessRevoked    AccessRequest[] @relation("AccessRevoker")
  accessCreated    AccessRequest[] @relation("AccessCreator")
  deploysExecuted  Deployment[]    @relation("DeployExecutor")
  deploysCreated   Deployment[]    @relation("DeployCreator")
  backupsVerified  BackupRecord[]  @relation("BackupVerifier")
  backupsCreated   BackupRecord[]  @relation("BackupCreator")
  itAssetsOwned    ItAsset[]       @relation("ItAssetOwner")

  notifications Notification[]

  invoiceRuns     InvoiceRun[] @relation("InvoiceRunCreator")
  invoicesCreated Invoice[]    @relation("InvoiceCreator")
  paymentsReceived Payment[]          @relation("PaymentReceiver")
  paymentsCreated  Payment[]          @relation("PaymentCreator")
  gatewayTxCreated PaymentGatewayTx[] @relation("GatewayTxCreator")
  suspensionsCreated ServiceSuspension[] @relation("SuspensionCreator")
  journalsPosted     JournalEntry[]      @relation("JournalPoster")
  cticketsAssigned  CustomerTicket[]     @relation("CTicketAssignee")
  cticketsCreated   CustomerTicket[]     @relation("CTicketCreator")
  cticketMembers    TicketMember[]       @relation("CTicketMember")
  cticketPauses     TicketPause[]        @relation("CTicketPauser")
  cticketStepsDone  TicketStepProgress[] @relation("CTicketStepDoer")
  employee          Employee?            @relation("EmployeeUser")
  outboundCreated   OutboundMessage[]    @relation("OutboundCreator")
  announcements     Announcement[]       @relation("AnnouncementCreator")
  transferReceipts TransferReceipt[] @relation("TransferReceiver")
  doCreated        DeliveryOrder[] @relation("DoCreator")
  doApproved       DeliveryOrder[] @relation("DoApprover")
  irfCreated       InventoryRequestForm[] @relation("IrfCreator")
  signatures       DocumentSignature[] @relation("SignatureSigner")
  returnRequested  ReturnRequest[] @relation("ReturnRequester")
  returnVerified   ReturnRequest[] @relation("ReturnVerifier")
  materialRequests MaterialRequest[] @relation("MrqRequester")
  materialDecided  MaterialRequest[] @relation("MrqDecider")
  slotLedgerEntries SlotLedger[] @relation("SlotLedgerCreator")
  warehouseScopes UserWarehouseScope[] @relation("WarehouseScopeUser")
  terminationsCreated CustomerTermination[] @relation("TerminationCreator")
  terminationsDecided CustomerTermination[] @relation("TerminationDecider")
  recoveriesAssigned  DeviceRecoveryIssue[] @relation("RecoveryAssignee")
  recoveryItemsReceived DeviceRecoveryItem[] @relation("RecoveryReceiver")
  recoveryAttempts    DeviceRecoveryAttempt[] @relation("RecoveryAttemptUser")
  deviceInspections   DeviceInspection[] @relation("DeviceInspector")
}

model Division {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  users         User[]
  approvalSteps ApprovalStep[]
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)

  users         UserRole[]
  permissions   RolePermission[]
  ruleSteps     ApprovalRuleStep[]
  approvalSteps ApprovalStep[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // format: "<module>.<action>", mis. "users.view"
  module      String
  action      String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ── Audit Log (append-only: tidak ada jalur update/delete di aplikasi) ──

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String // LOGIN, LOGIN_FAILED, USER_CREATE, APPROVAL_APPROVE, ...
  module      String
  entityType  String?
  entityId    String?
  description String
  metadata    String? // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ── Approval Engine ─────────────────────────────────────────────
// ApprovalRule = approval matrix terkonfigurasi (PRD §48).
// Matching: module + subtype (opsional) + rentang amount (opsional).

model ApprovalRule {
  id        String  @id @default(cuid())
  module    String // petty_cash | network_change | deployment | ...
  subtype   String? // mis. network_change: standard|normal|major|emergency
  name      String
  minAmount BigInt  @default(0) // rupiah, inklusif
  maxAmount BigInt? // rupiah, inklusif; null = tak terbatas
  isActive  Boolean @default(true)

  steps    ApprovalRuleStep[]
  requests ApprovalRequest[]

  @@index([module, isActive])
}

model ApprovalRuleStep {
  id        String  @id @default(cuid())
  ruleId    String
  stepOrder Int // 1, 2, 3, ...
  // ROLE       = role fungsional tertentu (roleId wajib)
  // SUPERVISOR = supervisor divisi pengaju (dinamis, di-resolve saat submit)
  // OWNER      = user level owner
  approverType String  @default("ROLE")
  roleId       String?

  rule ApprovalRule @relation(fields: [ruleId], references: [id])
  role Role?        @relation(fields: [roleId], references: [id])

  @@unique([ruleId, stepOrder])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  requestNumber String    @unique // APR-YYYYMM-####
  module        String
  subtype       String?
  entityType    String? // diisi modul lain (mis. "CashTransaction")
  entityId      String?
  title         String
  description   String?
  amount        BigInt?
  status        String    @default("PENDING") // PENDING|APPROVED|REJECTED|CANCELLED
  currentStep   Int       @default(1)
  ruleId        String
  requestedById String
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  rule        ApprovalRule   @relation(fields: [ruleId], references: [id])
  requestedBy User           @relation("Requester", fields: [requestedById], references: [id])
  steps       ApprovalStep[]

  @@index([status, createdAt])
  @@index([requestedById])
}

model ApprovalStep {
  id           String    @id @default(cuid())
  requestId    String
  stepOrder    Int
  approverType String    @default("ROLE") // ROLE | SUPERVISOR | OWNER
  roleId       String? // untuk approverType ROLE
  divisionId   String? // untuk approverType SUPERVISOR (divisi pengaju saat submit)
  status       String    @default("PENDING") // PENDING|APPROVED|REJECTED
  actedById    String?
  note         String?
  actedAt      DateTime?

  request  ApprovalRequest @relation(fields: [requestId], references: [id])
  role     Role?           @relation(fields: [roleId], references: [id])
  division Division?       @relation(fields: [divisionId], references: [id])
  actedBy  User?           @relation("Actor", fields: [actedById], references: [id])

  @@unique([requestId, stepOrder])
}

// ── Master Data (soft-deactivate, tidak pernah dihapus) ─────────

model CostCenter {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  cashTransactions CashTransaction[]
  journalLines     JournalLine[]
}

/// Fase 21 (F12) — kategori material dua tingkat: kategori di atas materialType,
/// mengikuti pengelompokan FTTH (Cable, Connector, Network Device, dst).
model Category {
  /// Cable | Connector | Network Device | Passive Device | Power | Consumable | Tools | Other
  materialType String?
  id       String  @id @default(cuid())
  type     String // EXPENSE | ITEM | TICKET | ... (Phase 1: EXPENSE)
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  items            Item[]
  cashTransactions CashTransaction[]

  @@index([type])
}

model Area {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  campaigns    Campaign[]
  customers    Customer[]
  projects     Project[]
  networkSites NetworkSite[]
  incidents    Incident[]
}

model Package {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  downloadMbps    Int
  uploadMbps      Int
  monthlyPrice    BigInt // rupiah
  installationFee BigInt  @default(0) // rupiah
  description     String?
  isActive        Boolean @default(true)

  interestedLeads Lead[]
  surveys         Survey[]
  quotations      Quotation[]
  subscriptions   Subscription[]
}

// ── Phase 2: Sales & CRM ────────────────────────────────────────

model Campaign {
  id             String    @id @default(cuid())
  campaignNumber String    @unique // CMP-####
  name           String
  channel        String
  startDate      DateTime?
  endDate        DateTime?
  budget         BigInt    @default(0)
  targetAudience String?
  areaId         String?
  picId          String?
  targetLeads    Int       @default(0)
  status         String    @default("DRAFT") // DRAFT|ACTIVE|COMPLETED|CANCELLED
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  area  Area?  @relation(fields: [areaId], references: [id])
  pic   User?  @relation("CampaignPic", fields: [picId], references: [id])
  leads Lead[]
}

model Lead {
  id                String    @id @default(cuid())
  leadNumber        String    @unique // LD-YYYYMM-####
  name              String
  company           String?
  phone             String
  email             String?
  address           String?
  latitude          Float?
  longitude         Float?
  customerType      String    @default("RESIDENTIAL")
  source            String    @default("OTHER")
  campaignId        String?
  interestPackageId String?
  estBandwidthMbps  Int?
  salesOwnerId      String?
  nextFollowUpAt    DateTime?
  status            String    @default("NEW")
  notes             String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign        Campaign?      @relation(fields: [campaignId], references: [id])
  interestPackage Package?       @relation(fields: [interestPackageId], references: [id])
  salesOwner      User?          @relation("LeadOwner", fields: [salesOwnerId], references: [id])
  createdBy       User           @relation("LeadCreator", fields: [createdById], references: [id])
  activities      LeadActivity[]
  opportunity     Opportunity?
  surveys         Survey[]
  quotations      Quotation[]
  customer        Customer?

  @@index([status])
  @@index([salesOwnerId])
}

model LeadActivity {
  id             String    @id @default(cuid())
  leadId         String
  type           String // PHONE_CALL|WHATSAPP|EMAIL|MEETING|SITE_VISIT|PRESENTATION|SURVEY_REQUEST|QUOTATION_SENT|NEGOTIATION|CONTRACT_SIGNING
  note           String
  activityAt     DateTime  @default(now())
  nextFollowUpAt DateTime?
  doneById       String

  lead   Lead @relation(fields: [leadId], references: [id])
  doneBy User @relation("ActivityUser", fields: [doneById], references: [id])

  @@index([leadId, activityAt])
}

model Opportunity {
  id              String    @id @default(cuid())
  oppNumber       String    @unique // OPP-YYYYMM-####
  leadId          String    @unique
  stage           String    @default("NEW_LEAD")
  estMonthlyValue BigInt?
  lostReason      String?
  notes           String?
  wonAt           DateTime?
  lostAt          DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead      Lead @relation(fields: [leadId], references: [id])
  createdBy User @relation("OppCreator", fields: [createdById], references: [id])

  @@index([stage])
}

model Survey {
  id             String    @id @default(cuid())
  surveyNumber   String    @unique // SVY-YYYYMM-####
  leadId         String?
  customerId     String?
  address        String
  latitude       Float?
  longitude      Float?
  contactName    String?
  contactPhone   String?
  packageId      String?
  bandwidthMbps  Int?
  scheduledAt    DateTime?
  technicianId   String?
  nearestNode    String?
  estCableMeters Int?
  estMaterials   String?
  estCost        BigInt?
  signalLevel    String?
  opticalPower   String?
  feasibility    String? // FEASIBLE|FEASIBLE_WITH_COST|NOT_FEASIBLE
  resultNotes    String?
  status         String    @default("SUBMITTED") // SUBMITTED|SCHEDULED|IN_PROGRESS|COMPLETED|CANCELLED
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead       Lead?     @relation(fields: [leadId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
  package    Package?  @relation(fields: [packageId], references: [id])
  technician User?     @relation("SurveyTechnician", fields: [technicianId], references: [id])
  createdBy  User      @relation("SurveyCreator", fields: [createdById], references: [id])

  @@index([status])
}

model Quotation {
  id              String    @id @default(cuid())
  quotationNumber String // QUO-YYYYMM-#### (sama untuk semua versi)
  version         Int       @default(1)
  leadId          String
  packageId       String
  monthlyPrice    BigInt
  installationFee BigInt    @default(0)
  deviceFee       BigInt    @default(0)
  networkBuildFee BigInt    @default(0)
  discount        BigInt    @default(0) // potongan biaya one-time; >0 wajib approval
  taxPercent      Float     @default(11)
  contractMonths  Int       @default(12)
  validUntil      DateTime?
  notes           String?
  status          String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|SENT|ACCEPTED|REJECTED|EXPIRED|SUPERSEDED
  acceptedAt      DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead      Lead    @relation(fields: [leadId], references: [id])
  package   Package @relation(fields: [packageId], references: [id])
  createdBy User    @relation("QuotationCreator", fields: [createdById], references: [id])

  @@unique([quotationNumber, version])
  @@index([status])
}

model Customer {
  id             String   @id @default(cuid())
  customerNumber String   @unique // CST-#####
  name           String
  company        String?
  phone          String
  email          String?
  address        String
  latitude       Float?
  longitude      Float?
  customerType   String   @default("RESIDENTIAL")
  notifyChannel  String   @default("NONE") // NONE|WHATSAPP|EMAIL|APP
  areaId         String?
  salesOwnerId   String?
  source         String?
  leadId         String?  @unique
  status         String   @default("ACTIVE") // ACTIVE|INACTIVE
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  area          Area?          @relation(fields: [areaId], references: [id])
  salesOwner    User?          @relation("CustomerOwner", fields: [salesOwnerId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id])
  createdBy     User           @relation("CustomerCreator", fields: [createdById], references: [id])
  subscriptions Subscription[]
  surveys       Survey[]
  devices       SerializedDevice[]
  workOrders    WorkOrder[]
  projects      Project[]
  invoices      Invoice[]
  payments      Payment[]
  gatewayTxs    PaymentGatewayTx[]
  customerTickets CustomerTicket[]
  outboundMessages OutboundMessage[]
  terminations CustomerTermination[]
}

model Subscription {
  id             String    @id @default(cuid())
  serviceNumber  String    @unique // SVC-#####
  customerId     String
  packageId      String
  monthlyPrice   BigInt
  downloadMbps   Int
  uploadMbps     Int
  billingCycleDay Int      @default(1)
  popNode        String?
  vlan           String?
  pppoeUsername  String?
  routerId       String? // distribution router (NetworkDevice) — jalur isolir
  ipAddress      String?
  contractMonths Int?
  quotationId    String?
  activatedAt    DateTime?
  terminatedAt   DateTime?
  status         String    @default("DRAFT") // DRAFT|WAITING_INSTALLATION|ACTIVE|ISOLATED|SUSPENDED|TERMINATED
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  package   Package  @relation(fields: [packageId], references: [id])
  createdBy User     @relation("SubscriptionCreator", fields: [createdById], references: [id])
  devices         SerializedDevice[]
  workOrders      WorkOrder[]
  ips             IPAddress[]
  incidentImpacts IncidentSubscription[]
  addons          SubscriptionAddon[]
  billingProfile  BillingProfile?
  invoices        Invoice[]
  router          NetworkDevice?         @relation("SubscriptionRouter", fields: [routerId], references: [id])
  suspensions     ServiceSuspension[]
  accessJobs      NetworkAccessJob[]
  customerTickets CustomerTicket[]
  odpPort         OdpPort?

  @@index([status])
  pppoeSessions PppoeSession[]
  terminations CustomerTermination[]
}

// Bukti/lampiran generik (foto survey, nota, dsb.)
model Attachment {
  id           String   @id @default(cuid())
  entityType   String // "Survey" | "Lead" | ...
  entityId     String
  filename     String // nama asli
  storedName   String   @unique // nama file di disk
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  signatures DocumentSignature[]
}

// ── Phase 3: Inventory & Operational ────────────────────────────
// Prinsip (PRD §7, §15–18, §21, §53):
//  - Stock HANYA berubah lewat StockTransaction berstatus POSTED.
//  - Transaksi POSTED immutable; koreksi = transaksi reversal baru.
//  - Stock tidak boleh negatif; serial number unik.
//  - Perangkat serialized punya tepat satu lokasi & satu custodian aktif.

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String?
  /// Fase 20 (F10) — CENTRAL|BRANCH|MINI_STOCK|PROJECT_STOCK.
  /// Stok teknisi TIDAK dijadikan tipe gudang; tetap memakai CustodyLevel.
  type      String  @default("CENTRAL")
  latitude  Float?
  longitude Float?
  isActive Boolean @default(true)

  stockLevels StockLevel[]
  devices     SerializedDevice[]
  txFrom      StockTransaction[] @relation("TxFrom")
  txTo        StockTransaction[] @relation("TxTo")
  opnames     OpnameSession[]
  returnRequests ReturnRequest[] @relation("ReturnWarehouse")
  materialRequests MaterialRequest[] @relation("MrqWarehouse")
  racks      Rack[]
  stockSlots StockSlot[]
  userScopes UserWarehouseScope[] @relation("WarehouseScope")
  terminationsIn CustomerTermination[] @relation("TerminationWarehouse")
  recoveriesIn   DeviceRecoveryIssue[] @relation("RecoveryWarehouse")
}

model Item {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  categoryId   String?
  brand        String?
  model        String?
  unit         String  @default("pcs") // pcs | meter | roll | box | set
  /// Fase 21 (F12) — barcode/QR untuk pemindaian di opname & pengambilan barang.
  barcode      String? @unique
  trackingType String  @default("BULK") // SERIALIZED | BULK
  minStock     Int     @default(0)
  isActive     Boolean @default(true)

  category    Category?              @relation(fields: [categoryId], references: [id])
  stockLevels StockLevel[]
  devices     SerializedDevice[]
  txLines     StockTransactionLine[]
  opnameLines OpnameLine[]
  custodyLevels CustodyLevel[]
  bomLines      ProjectBomLine[]
  transferReceiptLines TransferReceiptLine[]
  deliveryOrderLines DeliveryOrderLine[]
  returnRequestLines ReturnRequestLine[]
  materialRequestLines MaterialRequestLine[]
  slotAllocations SlotAllocation[]
  slotLedger      SlotLedger[]
}

// Saldo stock per gudang — HANYA diubah oleh postTransaction/reverseTransaction.
/// Saldo stock per (item × gudang), berdimensi — Fase 16 (PRD-WAREHOUSE-ENHANCEMENT F1).
/// available = onHand − reserved, SELALU turunan; tidak pernah disimpan sebagai kolom.
/// Keempat angka hanya berubah lewat transaksi yang diposting (inventory.ts).
model StockLevel {
  id          String @id @default(cuid())
  itemId      String
  warehouseId String
  onHand      Int    @default(0) // fisik ada di gudang
  reserved    Int    @default(0) // ditahan draft issue/transfer yang belum diposting
  damaged     Int    @default(0) // rusak, tidak bisa dipakai
  inTransit   Int    @default(0) // dalam perjalanan antar gudang (dipakai Fase 17)

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
}

// Saldo material bulk yang dibawa teknisi (virtual inventory custody).
model CustodyLevel {
  id          String @id @default(cuid())
  custodianId String
  itemId      String
  qty         Int    @default(0)

  custodian User @relation("CustodyLevels", fields: [custodianId], references: [id])
  item      Item @relation(fields: [itemId], references: [id])

  @@unique([custodianId, itemId])
}

model StockTransaction {
  id              String    @id @default(cuid())
  txNumber        String    @unique // GR-/ISS-/RET-/TRF-/ADJ-YYYYMM-####
  type            String // GOODS_RECEIPT|STOCK_ISSUE|STOCK_RETURN|STOCK_TRANSFER|STOCK_ADJUSTMENT
  status          String    @default("DRAFT") // DRAFT | POSTED
  warehouseFromId String?
  warehouseToId   String?
  custodianId     String? // teknisi penerima (issue) / pengembali (return)
  workOrderId     String?
  projectId       String? // material proyek (PRD §19)
  referenceNote   String? // PO, proyek, dsb.
  purpose         String // tujuan wajib (PRD §16.2)
  notes           String?
  createdById     String
  postedById      String?
  postedAt        DateTime?
  reversalOfId    String?   @unique // transaksi ini adalah reversal dari ...
  reversedById    String?   @unique // transaksi ini telah di-reverse oleh ...
  // Fase 17 — hanya untuk STOCK_TRANSFER. Posting = pengiriman; barang masuk
  // inTransit gudang tujuan sampai diterima. PENDING|PARTIAL|RECEIVED.
  receiveStatus   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  warehouseFrom Warehouse?             @relation("TxFrom", fields: [warehouseFromId], references: [id])
  warehouseTo   Warehouse?             @relation("TxTo", fields: [warehouseToId], references: [id])
  custodian     User?                  @relation("TxCustodian", fields: [custodianId], references: [id])
  workOrder     WorkOrder?             @relation(fields: [workOrderId], references: [id])
  project       Project?               @relation(fields: [projectId], references: [id])
  createdBy     User                   @relation("TxCreator", fields: [createdById], references: [id])
  postedBy      User?                  @relation("TxPoster", fields: [postedById], references: [id])
  reversalOf    StockTransaction?      @relation("TxReversal", fields: [reversalOfId], references: [id])
  reversedBy    StockTransaction?      @relation("TxReversal")
  lines         StockTransactionLine[]
  receipts      TransferReceipt[]
  deliveryOrders DeliveryOrder[]
  irf            InventoryRequestForm?
  returnRequest  ReturnRequest?

  @@index([type, status])
  materialRequest MaterialRequest?
}

model StockTransactionLine {
  id       String  @id @default(cuid())
  txId     String
  itemId   String
  qty      Int
  deviceId String? // untuk item SERIALIZED: satu baris per unit (qty=1)
  snInput  String? // SN yang akan dibuat saat posting goods receipt
  /// Fase 18 — kondisi barang saat dikembalikan: GOOD|USED|DAMAGED|RMA.
  /// GOOD/USED masuk onHand, DAMAGED/RMA masuk dimensi damaged.
  condition String?

  tx           StockTransaction      @relation(fields: [txId], references: [id])
  item         Item                  @relation(fields: [itemId], references: [id])
  device       SerializedDevice?     @relation(fields: [deviceId], references: [id])
  receiptLines TransferReceiptLine[]

  @@index([txId])
  deliveryOrderLines DeliveryOrderLine[]
}

model SerializedDevice {
  id              String    @id @default(cuid())
  serialNumber    String    @unique
  macAddress      String?
  itemId          String
  /// Fase 28 (PRD terminasi §13.1) — COMPANY = milik PERUMNET dan WAJIB ditarik
  /// saat pelanggan terminasi; CUSTOMER = milik pelanggan dan TIDAK BOLEH masuk
  /// recovery. Default COMPANY mengikuti saran konservatif PRD §20.2; perangkat
  /// milik pelanggan harus dikoreksi lewat jalur ber-audit sebelum modul
  /// terminasi dipakai produksi.
  ownership       String    @default("COMPANY") // COMPANY | CUSTOMER
  condition       String    @default("GOOD") // GOOD | SECOND | DAMAGED
  status          String    @default("AVAILABLE") // AVAILABLE|IN_CUSTODY|INSTALLED|UNDER_INSPECTION|DAMAGED|LOST|SCRAPPED
  warehouseId     String? // terisi saat berada di gudang
  custodianId     String? // terisi saat dibawa teknisi
  subscriptionId  String? // terisi saat terpasang di pelanggan
  customerId      String?
  acquisitionCost BigInt?
  warrantyUntil   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  item         Item              @relation(fields: [itemId], references: [id])
  warehouse    Warehouse?        @relation(fields: [warehouseId], references: [id])
  custodian    User?             @relation("DeviceCustodian", fields: [custodianId], references: [id])
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  txLines      StockTransactionLine[]
  movements    DeviceMovement[]

  @@index([status])
  @@index([custodianId])
  returnRequestLines ReturnRequestLine[]
  recoveryItems DeviceRecoveryItem[]
}

// Riwayat perangkat — append-only.
model DeviceMovement {
  id          String   @id @default(cuid())
  deviceId    String
  action      String // RECEIVED|ISSUED|RETURNED|TRANSFERRED|INSTALLED|WRITEOFF_REQUESTED|WRITTEN_OFF|REVERSED
  fromNote    String?
  toNote      String?
  txId        String?
  workOrderId String?
  byUserId    String
  note        String?
  createdAt   DateTime @default(now())

  device    SerializedDevice @relation(fields: [deviceId], references: [id])
  byUser    User             @relation("DeviceMover", fields: [byUserId], references: [id])
  workOrder WorkOrder?       @relation(fields: [workOrderId], references: [id])

  @@index([deviceId, createdAt])
}

model WorkOrder {
  id                   String    @id @default(cuid())
  woNumber             String    @unique // WO-YYYYMM-####
  type                 String // NEW_INSTALLATION|TROUBLESHOOTING|DEVICE_REPLACEMENT|DEVICE_RETRIEVAL|MAINTENANCE
  status               String    @default("OPEN") // OPEN|ASSIGNED|IN_PROGRESS|COMPLETED|CLOSED|CANCELLED
  customerId           String?
  subscriptionId       String?
  address              String
  description          String
  scheduledAt          DateTime?
  technicianId         String?
  resultNotes          String?
  customerConfirmation String? // nama pelanggan yang mengonfirmasi (PRD §18)
  createdById          String
  closedById           String?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer     Customer?          @relation(fields: [customerId], references: [id])
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])
  technician   User?              @relation("WoTechnician", fields: [technicianId], references: [id])
  createdBy    User               @relation("WoCreator", fields: [createdById], references: [id])
  closedBy     User?              @relation("WoCloser", fields: [closedById], references: [id])
  transactions StockTransaction[]
  movements    DeviceMovement[]
  materialUsages MaterialUsage[]
  cashTransactions CashTransaction[]
  incidents        Incident[]
  customerTickets  CustomerTicket[]

  @@index([status])
  @@index([technicianId])
  materialRequests MaterialRequest[]
  deviceRecovery DeviceRecoveryIssue?
}

// Pemakaian material bulk pada WO — mengurangi custody teknisi.
model MaterialUsage {
  id          String   @id @default(cuid())
  workOrderId String
  itemId      String
  qty         Int
  note        String?
  byUserId    String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  byUser    User      @relation("MaterialUser", fields: [byUserId], references: [id])
}

model OpnameSession {
  id                String    @id @default(cuid())
  opnameNumber      String    @unique // OPN-YYYYMM-####
  warehouseId       String
  status            String    @default("OPEN") // OPEN|WAITING_APPROVAL|POSTED|CANCELLED
  notes             String?
  createdById       String
  approvalRequestId String?
  adjustmentTxId    String?
  postedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  createdBy User         @relation("OpnameCreator", fields: [createdById], references: [id])
  lines     OpnameLine[]
}

model OpnameLine {
  id         String  @id @default(cuid())
  sessionId  String
  itemId     String
  systemQty  Int // snapshot saat sesi dibuat (cut-off)
  countedQty Int?
  reason     String? // wajib bila variance != 0

  session OpnameSession @relation(fields: [sessionId], references: [id])
  item    Item          @relation(fields: [itemId], references: [id])

  @@unique([sessionId, itemId])
}

// ── Phase 4: Finance & Project ──────────────────────────────────
// Prinsip (PRD §22–27, §19, §53):
//  - Saldo cashbook HANYA berubah lewat posting CashTransaction.
//  - Transaksi posted immutable; koreksi = reversal.
//  - Saldo tidak boleh negatif; expense wajib kategori + cost center + bukti.
//  - Cash advance wajib due date; overdue memblokir pengajuan baru.
//  - Monthly closing mengunci periode (reversal periode terkunci ditolak).

model Cashbook {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  balance     BigInt    @default(0) // HANYA diubah engine posting
  lockedUntil DateTime? // monthly closing lock
  isActive    Boolean   @default(true)

  transactions CashTransaction[] @relation("CashbookMain")
  transfersIn  CashTransaction[] @relation("CashbookTo")
  closings     CashClosing[]
}

model CashTransaction {
  id               String    @id @default(cuid())
  txNumber         String    @unique // CSH-/EXP-/RBM-/ADV-/STL-/CTF-YYYYMM-####
  type             String // TOP_UP|EXPENSE|REIMBURSEMENT|CASH_ADVANCE|ADVANCE_SETTLEMENT|CASH_TRANSFER
  status           String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|POSTED|REJECTED|CANCELLED
  cashbookId       String
  cashbookToId     String? // transfer
  amount           BigInt // nominal utama (settlement: porsi expense)
  cashReturnAmount BigInt    @default(0) // settlement: kas dikembalikan
  categoryId       String?
  costCenterId     String?
  recipient        String? // penerima dana (wajib expense)
  purpose          String // tujuan wajib (PRD §23)
  receiptRef       String? // no. nota — deteksi duplikasi (PRD §24)
  referenceNote    String?
  workOrderId      String?
  projectId        String?
  advanceId        String? // settlement → advance induk
  dueDate          DateTime? // cash advance
  settledAmount    BigInt    @default(0) // advance: akumulasi pertanggungjawaban
  settledAt        DateTime?
  claimantId       String? // reimbursement
  approvalRequestId String?
  createdById      String
  postedById       String?
  postedAt         DateTime?
  reversalOfId     String?   @unique
  reversedById     String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cashbook    Cashbook          @relation("CashbookMain", fields: [cashbookId], references: [id])
  cashbookTo  Cashbook?         @relation("CashbookTo", fields: [cashbookToId], references: [id])
  category    Category?         @relation(fields: [categoryId], references: [id])
  costCenter  CostCenter?       @relation(fields: [costCenterId], references: [id])
  workOrder   WorkOrder?        @relation(fields: [workOrderId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id])
  advance     CashTransaction?  @relation("AdvanceSettlements", fields: [advanceId], references: [id])
  settlements CashTransaction[] @relation("AdvanceSettlements")
  claimant    User?             @relation("CashClaimant", fields: [claimantId], references: [id])
  createdBy   User              @relation("CashCreator", fields: [createdById], references: [id])
  postedBy    User?             @relation("CashPoster", fields: [postedById], references: [id])
  reversalOf  CashTransaction?  @relation("CashReversal", fields: [reversalOfId], references: [id])
  reversedBy  CashTransaction?  @relation("CashReversal")

  @@index([type, status])
  @@index([cashbookId, postedAt])
  @@index([createdById])
}

model CashClosing {
  id              String   @id @default(cuid())
  closingNumber   String   @unique // CLS-YYYYMM-####
  cashbookId      String
  type            String // DAILY | MONTHLY
  closingDate     DateTime
  systemBalance   BigInt
  physicalBalance BigInt
  variance        BigInt // physical - system (PRD §27)
  reason          String? // wajib bila variance != 0
  lockedUntil     DateTime? // monthly: batas periode terkunci
  createdById     String
  createdAt       DateTime @default(now())

  cashbook  Cashbook @relation(fields: [cashbookId], references: [id])
  createdBy User     @relation("ClosingCreator", fields: [createdById], references: [id])

  @@index([cashbookId, closingDate])
}

model Project {
  id            String    @id @default(cuid())
  projectNumber String    @unique // PRJ-YYYY-####
  name          String
  customerId    String?
  areaId        String?
  managerId     String
  budget        BigInt    @default(0)
  status        String    @default("OPEN") // OPEN|CLOSED|CANCELLED
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  closedById    String?
  closedAt      DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer          Customer?          @relation(fields: [customerId], references: [id])
  area              Area?              @relation(fields: [areaId], references: [id])
  manager           User               @relation("ProjectManager", fields: [managerId], references: [id])
  closedBy          User?              @relation("ProjectCloser", fields: [closedById], references: [id])
  createdBy         User               @relation("ProjectCreator", fields: [createdById], references: [id])
  bomLines          ProjectBomLine[]
  cashTransactions  CashTransaction[]
  stockTransactions StockTransaction[]

  @@index([status])
}

model ProjectBomLine {
  id         String @id @default(cuid())
  projectId  String
  itemId     String
  plannedQty Int

  project Project @relation(fields: [projectId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@unique([projectId, itemId])
}

// ── Phase 5: NOC ────────────────────────────────────────────────
// Prinsip (PRD §28–35, §53):
//  - IP address tidak boleh duplikat dan wajib tertaut perangkat/layanan.
//  - Incident wajib severity + PIC; timeline append-only; incident besar
//    wajib root cause review dan hanya ditutup NOC Manager.
//  - Change wajib rollback plan, tidak dieksekusi tanpa approval,
//    emergency wajib post-review.

model NetworkSite {
  id               String  @id @default(cuid())
  siteCode         String  @unique
  name             String
  type             String // HEAD_OFFICE|DATA_CENTER|POP|MINI_POP|TOWER|ODC|ODP|RELAY|COLOCATION
  address          String?
  latitude         Float?
  longitude        Float?
  areaId           String?
  picId            String?
  status           String  @default("ACTIVE") // ACTIVE|INACTIVE|PLANNED
  powerSource      String?
  backupPower      String?
  upstreamProvider String?
  capacityNote     String?
  notes            String?

  area        Area?                @relation(fields: [areaId], references: [id])
  pic         User?                @relation("SitePic", fields: [picId], references: [id])
  devices     NetworkDevice[]
  linksA      NetworkLink[]        @relation("LinkSiteA")
  linksB      NetworkLink[]        @relation("LinkSiteB")
  subnets     Subnet[]
  odps        Odp[]
  alarms      NetworkAlarm[]
  incidents   Incident[]
  maintenance NetworkMaintenance[]
  probeTargets ProbeTarget[]
}

model NetworkDevice {
  id           String  @id @default(cuid())
  hostname     String  @unique
  deviceType   String // ROUTER|CORE_ROUTER|DIST_SWITCH|ACCESS_SWITCH|OLT|ONT|WIRELESS_BACKHAUL|ACCESS_POINT|FIREWALL|SERVER|UPS|OTHER
  vendor       String?
  model        String?
  serialNumber String?
  macAddress   String?
  managementIp String?
  siteId       String
  rack         String?
  uPosition    String?
  firmware     String?
  criticality  String  @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  status       String  @default("ACTIVE") // ACTIVE|INACTIVE|MAINTENANCE|DOWN
  ownerId      String?
  notes        String?

  site        NetworkSite          @relation(fields: [siteId], references: [id])
  owner       User?                @relation("NetDeviceOwner", fields: [ownerId], references: [id])
  ips           IPAddress[]
  alarms        NetworkAlarm[]
  incidents     Incident[]
  maintenance   NetworkMaintenance[]
  subscriptions Subscription[]     @relation("SubscriptionRouter")
  accessJobs    NetworkAccessJob[]
  oltDevice     OltDevice?
  mikrotikRouter MikrotikRouter?
  probeTargets ProbeTarget[]
}

model NetworkLink {
  id        String  @id @default(cuid())
  linkCode  String  @unique
  name      String?
  siteAId   String
  siteBId   String
  media     String // FIBER|WIRELESS|LEASED_LINE|VPN
  capacity  String?
  provider  String?
  circuitId String?
  isPrimary Boolean @default(true)
  status    String  @default("ACTIVE") // ACTIVE|DEGRADED|DOWN|INACTIVE
  notes     String?

  siteA     NetworkSite @relation("LinkSiteA", fields: [siteAId], references: [id])
  siteB     NetworkSite @relation("LinkSiteB", fields: [siteBId], references: [id])
  incidents Incident[]
}

model Subnet {
  id      String  @id @default(cuid())
  cidr    String  @unique // mis. 10.10.0.0/24
  name    String
  vlan    String?
  gateway String?
  purpose String // subnet wajib punya tujuan (PRD §29)
  ownerId String?
  siteId  String?
  notes   String?

  owner User?        @relation("SubnetOwner", fields: [ownerId], references: [id])
  site  NetworkSite? @relation(fields: [siteId], references: [id])
  ips   IPAddress[]
}

model IPAddress {
  id             String    @id @default(cuid())
  subnetId       String
  address        String    @unique // rule 18: tidak boleh duplikat
  status         String    @default("ALLOCATED") // ALLOCATED|RESERVED|RELEASED
  assignedType   String? // DEVICE|SUBSCRIPTION|OTHER
  deviceId       String?
  subscriptionId String?
  description    String?
  assignedAt     DateTime  @default(now())
  releasedAt     DateTime?
  createdById    String

  subnet       Subnet         @relation(fields: [subnetId], references: [id])
  device       NetworkDevice? @relation(fields: [deviceId], references: [id])
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])
  createdBy    User           @relation("IpCreator", fields: [createdById], references: [id])

  @@index([subnetId, status])
}

model NetworkAlarm {
  id               String    @id @default(cuid())
  alarmNumber      String    @unique // ALM-YYYYMM-####
  severity         String // INFORMATIONAL|WARNING|MINOR|MAJOR|CRITICAL
  source           String    @default("MANUAL") // MANUAL | kode integrasi (webhook §30)
  deviceId         String?
  siteId           String?
  message          String
  // Anti alarm-flooding (§31): alarm duplikat dikelompokkan, bukan baris baru.
  dedupKey         String?
  count            Int       @default(1)
  lastSeenAt       DateTime?
  occurredAt       DateTime  @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  incidentId       String?
  clearedAt        DateTime?
  createdById      String? // null = alarm otomatis dari integrasi monitoring
  createdAt        DateTime  @default(now())

  device         NetworkDevice? @relation(fields: [deviceId], references: [id])
  site           NetworkSite?   @relation(fields: [siteId], references: [id])
  acknowledgedBy User?          @relation("AlarmAck", fields: [acknowledgedById], references: [id])
  incident       Incident?      @relation(fields: [incidentId], references: [id])
  createdBy      User?          @relation("AlarmCreator", fields: [createdById], references: [id])

  @@index([severity, clearedAt])
  @@index([dedupKey, clearedAt])
}

model Incident {
  id               String    @id @default(cuid())
  incidentNumber   String    @unique // INC-YYYYMM-####
  title            String
  type             String // DEVICE_DOWN|LINK_DOWN|HIGH_LATENCY|PACKET_LOSS|POWER_OUTAGE|FIBER_CUT|WIRELESS_INTERFERENCE|UPSTREAM_OUTAGE|CORE_ISSUE|AUTH_FAILURE|DNS_ISSUE|SECURITY|OTHER
  severity         String // P1|P2|P3|P4 — wajib (rule 19)
  status           String    @default("DETECTED") // DETECTED|ACKNOWLEDGED|INVESTIGATING|MITIGATING|RESOLVED|CLOSED
  isOutage         Boolean   @default(false)
  picId            String?
  deviceId         String?
  linkId           String?
  siteId           String?
  areaId           String?
  detectedAt       DateTime  @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  rootCause        String?
  resolution       String?
  preventiveAction String?
  recoveryNote     String? // verifikasi pemulihan (PRD §32.4)
  // Outage communication (§33): hanya info yang disetujui NOC yang tampil
  // untuk Customer Service / Sales / Management di halaman /outages.
  isPublic         Boolean   @default(false)
  publicNote       String?
  publicEta        DateTime?
  publicUpdatedAt  DateTime?
  relatedChangeId  String?
  workOrderId      String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pic           User?                  @relation("IncidentPic", fields: [picId], references: [id])
  device        NetworkDevice?         @relation(fields: [deviceId], references: [id])
  link          NetworkLink?           @relation(fields: [linkId], references: [id])
  site          NetworkSite?           @relation(fields: [siteId], references: [id])
  area          Area?                  @relation(fields: [areaId], references: [id])
  relatedChange ChangeRequest?         @relation(fields: [relatedChangeId], references: [id])
  workOrder     WorkOrder?             @relation(fields: [workOrderId], references: [id])
  createdBy     User                   @relation("IncidentCreator", fields: [createdById], references: [id])
  updates       IncidentUpdate[]
  alarms        NetworkAlarm[]
  impacted      IncidentSubscription[]

  @@index([status, severity])
}

// Timeline incident — append-only.
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  note       String
  status     String? // status saat update (jejak transisi)
  byUserId   String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  byUser   User     @relation("IncidentUpdater", fields: [byUserId], references: [id])

  @@index([incidentId, createdAt])
}

model IncidentSubscription {
  id             String @id @default(cuid())
  incidentId     String
  subscriptionId String

  incident     Incident     @relation(fields: [incidentId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([incidentId, subscriptionId])
}

model NetworkMaintenance {
  id                String    @id @default(cuid())
  maintNumber       String    @unique // MNT-YYYYMM-####
  title             String
  type              String // PREVENTIVE|CORRECTIVE|EMERGENCY|FIRMWARE_UPGRADE|FIBER|POWER|TOWER|CAPACITY|SECURITY
  siteId            String?
  deviceId          String?
  purpose           String
  risk              String
  scheduledStart    DateTime
  scheduledEnd      DateTime
  estDowntimeMin    Int?
  picId             String
  status            String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|APPROVED|IN_PROGRESS|COMPLETED|CANCELLED
  approvalRequestId String?
  result            String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  site      NetworkSite?   @relation(fields: [siteId], references: [id])
  device    NetworkDevice? @relation(fields: [deviceId], references: [id])
  pic       User           @relation("MaintPic", fields: [picId], references: [id])
  createdBy User           @relation("MaintCreator", fields: [createdById], references: [id])

  @@index([status])
}

model ChangeRequest {
  id                String    @id @default(cuid())
  changeNumber      String    @unique // CHG-YYYYMM-####
  title             String
  changeType        String // STANDARD|NORMAL|MAJOR|EMERGENCY
  reason            String
  impactedDevices   String?
  impactedServices  String?
  risk              String
  implementationPlan String
  testPlan          String?
  rollbackPlan      String? // wajib kecuali STANDARD (rule 21, §35)
  windowStart       DateTime?
  windowEnd         DateTime?
  picId             String
  status            String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|APPROVED|COMPLETED|PENDING_REVIEW|FAILED|CANCELLED
  approvalRequestId String?
  result            String?
  implementedAt     DateTime?
  executedById      String?
  postReviewNote    String? // emergency wajib post-review (rule 23)
  postReviewedById  String?
  postReviewedAt    DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pic            User       @relation("ChangePic", fields: [picId], references: [id])
  executedBy     User?      @relation("ChangeExecutor", fields: [executedById], references: [id])
  postReviewedBy User?      @relation("ChangeReviewer", fields: [postReviewedById], references: [id])
  createdBy      User       @relation("ChangeCreator", fields: [createdById], references: [id])
  incidents      Incident[]

  @@index([status, changeType])
}

// ═══════════════ Phase 6: IT/DevOps (PRD §38–45) ═══════════════

model Server {
  id               String    @id @default(cuid())
  hostname         String    @unique
  environment      String // DEVELOPMENT|TESTING|STAGING|PRODUCTION|DR
  os               String?
  ipAddress        String?
  provider         String?
  region           String?
  cpu              String?
  ram              String?
  storage          String?
  ownerId          String?
  purpose          String // setiap server wajib punya tujuan (traceability)
  backupPolicy     String?
  monitoringStatus String? // MONITORED|UNMONITORED
  criticality      String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  expiryDate       DateTime? // sewa/kontrak VPS
  status           String    @default("ACTIVE") // ACTIVE|INACTIVE|DECOMMISSIONED
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner   User?          @relation("ServerOwner", fields: [ownerId], references: [id])
  apps    Application[]
  backups BackupRecord[]

  @@index([environment, status])
}

model Application {
  id               String   @id @default(cuid())
  name             String   @unique
  repository       String?
  ownerId          String? // technical owner
  businessOwnerId  String?
  environment      String // env utama aplikasi: DEVELOPMENT|TESTING|STAGING|PRODUCTION
  domain           String?
  techStack        String?
  databaseInfo     String?
  dependencyNote   String?
  deploymentMethod String?
  sla              String?
  backupNote       String?
  monitoringNote   String?
  status           String   @default("ACTIVE") // ACTIVE|INACTIVE|DEPRECATED
  serverId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner         User?          @relation("AppOwner", fields: [ownerId], references: [id])
  businessOwner User?          @relation("AppBusinessOwner", fields: [businessOwnerId], references: [id])
  server        Server?        @relation(fields: [serverId], references: [id])
  deployments   Deployment[]
  backups       BackupRecord[]
}

model ItTicket {
  id           String    @id @default(cuid())
  ticketNumber String    @unique // TIK-YYYYMM-####
  title        String
  type         String // LAPTOP_ISSUE|ACCOUNT_REQUEST|...(§39)
  priority     String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  description  String
  requesterId  String
  assigneeId   String?
  status       String    @default("NEW") // NEW|ASSIGNED|IN_PROGRESS|WAITING_USER|WAITING_VENDOR|RESOLVED|CLOSED
  resolution   String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester User  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy User  @relation("TicketCreator", fields: [createdById], references: [id])

  @@index([status, assigneeId])
}

model AccessRequest {
  id                String    @id @default(cuid())
  requestNumber     String    @unique // ACC-YYYYMM-####
  targetUserId      String // user penerima akses
  accessType        String // SERVER|DATABASE|REPOSITORY|CLOUD|NETWORK_DEVICE|CRM|MONITORING|EMAIL|VPN|DOMAIN|BILLING
  systemName        String // sistem spesifik yang diminta
  roleRequested     String // role/level akses
  reason            String
  isProduction      Boolean   @default(false) // rule 28: wajib approval
  isTemporary       Boolean   @default(false) // rule 29: wajib expiry
  expiryDate        DateTime?
  status            String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|GRANTED|REVOKED|REJECTED
  approvalRequestId String?
  grantedById       String?
  grantedAt         DateTime?
  revokedById       String?
  revokedAt         DateTime?
  revokeReason      String?
  createdById       String // requester
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  targetUser User  @relation("AccessTarget", fields: [targetUserId], references: [id])
  grantedBy  User? @relation("AccessGrantor", fields: [grantedById], references: [id])
  revokedBy  User? @relation("AccessRevoker", fields: [revokedById], references: [id])
  createdBy  User  @relation("AccessCreator", fields: [createdById], references: [id])

  @@index([targetUserId, status])
}

model Deployment {
  id                String    @id @default(cuid())
  deployNumber      String    @unique // DEP-YYYYMM-####
  applicationId     String
  version           String
  environment       String // DEVELOPMENT|TESTING|STAGING|PRODUCTION
  isMajor           Boolean   @default(false) // production: minor vs major (matrix §48)
  changeRecord      String? // rule 24: production wajib change record
  releaseNote       String?
  commitRef         String?
  hasMigration      Boolean   @default(false)
  migrationNote     String?
  deploymentPlan    String
  testingResult     String? // production: wajib terisi sebelum submit (§42)
  rollbackPlan      String? // rule 25: production wajib
  backupId          String? // §42: production wajib backup tersedia (SUCCESS + terverifikasi)
  windowStart       DateTime?
  windowEnd         DateTime?
  approvalRequestId String?
  status            String    @default("DRAFT") // DRAFT|WAITING_APPROVAL|READY|IN_PROGRESS|COMPLETED|FAILED|ROLLED_BACK|CANCELLED
  executedById      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  result            String?
  rollbackNote      String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  application Application   @relation(fields: [applicationId], references: [id])
  backup      BackupRecord? @relation(fields: [backupId], references: [id])
  executedBy  User?         @relation("DeployExecutor", fields: [executedById], references: [id])
  createdBy   User          @relation("DeployCreator", fields: [createdById], references: [id])

  @@index([status, environment])
}

model BackupRecord {
  id                 String    @id @default(cuid())
  backupNumber       String    @unique // BCK-YYYYMM-####
  serverId           String?
  applicationId      String?
  backupType         String // DATABASE|FILE|CONFIGURATION|VM_SNAPSHOT|NETWORK_CONFIG|OFFSITE
  schedule           String?
  location           String
  retention          String // §44: backup wajib punya retention
  isEncrypted        Boolean   @default(false) // §44: backup production wajib terenkripsi
  isCritical         Boolean   @default(false) // rule 27: wajib diverifikasi
  status             String // SUCCESS|FAILED
  failureNote        String?
  verificationResult String?
  verifiedById       String?
  verifiedAt         DateTime?
  restoreTestAt      DateTime?
  restoreTestResult  String?
  executedAt         DateTime
  createdById        String
  createdAt          DateTime  @default(now())

  server      Server?      @relation(fields: [serverId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  verifiedBy  User?        @relation("BackupVerifier", fields: [verifiedById], references: [id])
  createdBy   User         @relation("BackupCreator", fields: [createdById], references: [id])
  deployments Deployment[]

  @@index([status, executedAt])
}

model ItAsset {
  id            String    @id @default(cuid())
  name          String
  assetType     String // DOMAIN|SSL_CERT|CLOUD_SUBSCRIPTION|VPS|SOFTWARE_LICENSE|MONITORING_LICENSE|EMAIL_SERVICE|API_SUBSCRIPTION
  provider      String?
  ownerId       String?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  autoRenewal   Boolean   @default(false)
  cost          BigInt? // rupiah per periode
  paymentMethod String?
  reminderDays  Int       @default(30)
  status        String    @default("ACTIVE") // ACTIVE|EXPIRED|CANCELLED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner User? @relation("ItAssetOwner", fields: [ownerId], references: [id])

  @@unique([name, assetType])
  @@index([expiryDate])
}

// ═══════════════ Phase 7: Integrasi (PRD §30, §33, §50, §56) ═══════════════

// Notifikasi event-based (§50). Channel awal: in-app; kolom channel disiapkan
// agar adapter WhatsApp/email dapat ditambah tanpa mengubah skema.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // kode event, mis. APPROVAL_PENDING, BACKUP_FAILED
  title     String
  body      String?
  link      String? // path in-app, mis. /approvals/xxx
  module    String
  channel   String    @default("IN_APP") // IN_APP | WHATSAPP | EMAIL (adapter menyusul)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Registry integrasi eksternal (§56). Secret TIDAK disimpan di sini —
// credentialRef berisi NAMA environment variable (NFR: no plaintext secrets).
model Integration {
  id                String    @id @default(cuid())
  code              String    @unique // slug, dipakai di URL webhook
  name              String
  category          String // NETWORK|CRM_CUSTOMER|ITOPS|FINANCE
  provider          String // MIKROTIK|RADIUS|ZABBIX|...|OTHER
  baseUrl           String?
  authType          String    @default("NONE") // NONE|API_KEY|BASIC|TOKEN
  credentialRef     String? // nama env var yang menyimpan secret
  webhookToken      String // token inbound webhook (di-generate sistem)
  isEnabled         Boolean   @default(false)
  lastEventAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events           IntegrationEvent[]
  gatewayTxs       PaymentGatewayTx[]
  outboundMessages OutboundMessage[]
}

// Log lalu lintas integrasi (inbound webhook / outbound call).
model IntegrationEvent {
  id            String   @id @default(cuid())
  integrationId String
  direction     String // IN | OUT
  eventType     String // mis. MONITORING_ALERT
  payload       String? // JSON string (dipotong bila besar)
  status        String // OK | REJECTED | ERROR
  detail        String?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id])

  @@index([integrationId, createdAt])
}

// ═══════════════ Phase 8: Billing & Invoice (DESIGN-PHASE-8 §2) ═══════════════
// Catatan adaptasi dari rancangan: taxPercent memakai Float (Prisma tidak
// mendukung Decimal di SQLite); merchantId menyusul di Fase 9 (entitas
// Merchant menunggu keputusan §11.1).

// Layanan tambahan berbayar di luar paket (G13).
model AddonService {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  monthlyPrice  BigInt
  description   String?
  isActive      Boolean             @default(true)
  subscriptions SubscriptionAddon[]
}

model SubscriptionAddon {
  id             String    @id @default(cuid())
  subscriptionId String
  addonId        String
  priceOverride  BigInt? // null = pakai harga master addon
  startedAt      DateTime  @default(now())
  endedAt        DateTime? // null = masih aktif

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  addon        AddonService @relation(fields: [addonId], references: [id])

  @@unique([subscriptionId, addonId, startedAt])
  @@index([subscriptionId, endedAt])
}

// Profil penagihan per langganan — kapan terbit, jatuh tempo, PPN (G23).
model BillingProfile {
  id             String   @id @default(cuid())
  subscriptionId String   @unique
  billingStartAt DateTime // mulai ditagih
  invoiceDay     Int // tanggal terbit dalam bulan (1–28)
  dueDays        Int      @default(20)
  isolirDay      Int? // tanggal pemutusan bila belum bayar (dipakai Fase 10)
  taxPercent     Float    @default(0) // PPN % — snapshot ke invoice saat terbit
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// Batch tagihan bulanan — idempoten (G4).
model InvoiceRun {
  id          String    @id @default(cuid())
  period      String // "2026-08"
  scope       String    @default("ALL")
  status      String    @default("DRAFT") // DRAFT|PREVIEW|POSTED|CANCELLED
  totalCount  Int       @default(0)
  totalAmount BigInt    @default(0)
  createdById String
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  createdBy User      @relation("InvoiceRunCreator", fields: [createdById], references: [id])
  invoices  Invoice[]

  @@unique([period, scope])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique // INV-YYYYMM-####
  invoiceRunId   String?
  customerId     String
  subscriptionId String?
  type           String    @default("MONTHLY") // MONTHLY|INSTALLATION|ADDON|ADJUSTMENT|MANUAL
  period         String? // "2026-08" untuk MONTHLY
  issuedAt       DateTime
  dueAt          DateTime
  subtotal       BigInt
  taxPercent     Float     @default(0) // snapshot — tidak berubah saat tarif PPN ganti
  taxAmount      BigInt    @default(0)
  totalAmount    BigInt
  paidAmount     BigInt    @default(0) // diisi modul Payment (Fase 9)
  status         String    @default("DRAFT") // DRAFT|OPEN|PARTIAL|PAID|VOID|WRITTEN_OFF
  voidReason     String?
  journalEntryId String?   @unique // diisi modul GL (Fase 11)
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoiceRun   InvoiceRun?   @relation(fields: [invoiceRunId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  createdBy    User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]
  gatewayTxs   PaymentGatewayTxInvoice[]

  // Kunci idempotensi generator bulanan (§2.2).
  @@unique([subscriptionId, period, type])
  @@index([status, dueAt])
  @@index([customerId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  kind        String // PACKAGE|ADDON|INSTALLATION|DISCOUNT|ADJUSTMENT
  refId       String? // id paket/addon terkait
  description String
  quantity    Int     @default(1)
  unitPrice   BigInt
  amount      BigInt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ═══════════════ Phase 9: Payment & Merchant/Kolektor (DESIGN-PHASE-8 §3) ═══════════════
// Adaptasi dari rancangan: feePercent Float (SQLite tanpa Decimal);
// cashAccountId/feePayableAccountId (CoA) menyusul Fase 11 — sementara
// merchant ditautkan ke Cashbook; invoiceIds gateway memakai tabel relasi
// (SQLite tanpa scalar list); Payment.receivedById nullable untuk pembayaran
// gateway (tanpa kasir). Cashbook.balance TIDAK diubah modul ini — jurnal
// kas/piutang terpadu menyusul di GL Fase 11.

// Unit penagih / mitra kolektor (BUMDES) — keputusan §11.1: entitas baru.
model Merchant {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  contactName    String?
  phone          String?
  address        String?
  latitude       Float?
  longitude      Float?
  isPaymentPoint Boolean @default(false)
  cashbookId     String? // kas setoran mitra (jembatan ke CoA di Fase 11)
  feePercent     Float   @default(0) // §11.3: komisi persen per merchant
  isActive       Boolean @default(true)

  payments Payment[]
}

model Payment {
  id             String    @id @default(cuid())
  paymentNumber  String    @unique // PAY-YYYYMM-####
  customerId     String
  merchantId     String?
  receivedById   String? // kasir/kolektor — null untuk pembayaran gateway
  method         String // CASH|TRANSFER|GATEWAY
  cashbookId     String? // kas tujuan setoran (CASH/TRANSFER)
  gatewayTxId    String? // untuk GATEWAY
  amount         BigInt
  feeAmount      BigInt    @default(0) // biaya gateway / komisi kolektor
  netAmount      BigInt
  paidAt         DateTime
  status         String    @default("DRAFT") // DRAFT|POSTED|REVERSED
  journalEntryId String?   @unique // diisi GL Fase 11
  reversalOfId   String?   @unique
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id])
  merchant    Merchant?           @relation(fields: [merchantId], references: [id])
  receivedBy  User?               @relation("PaymentReceiver", fields: [receivedById], references: [id])
  gatewayTx   PaymentGatewayTx?   @relation(fields: [gatewayTxId], references: [id])
  reversalOf  Payment?            @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversal    Payment?            @relation("PaymentReversal")
  createdBy   User                @relation("PaymentCreator", fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([status, paidAt])
  @@index([customerId])
}

// Alokasi eksplisit: 1 pembayaran → banyak invoice (§3.2).
model PaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  invoiceId String
  amount    BigInt

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
}

// Bundle pembayaran multi-invoice via payment gateway (padanan "Bundle Payment").
model PaymentGatewayTx {
  id            String    @id @default(cuid())
  bundleRef     String    @unique // GTX-YYYYMM-####
  provider      String // WINPAY|DUITKU|TRIPAY|OTHER
  integrationId String? // adapter Integration (webhook & kredensial)
  customerId    String
  totalAmount   BigInt
  paidAmount    BigInt    @default(0)
  paymentUrl    String? // diisi saat adapter gateway live
  expiresAt     DateTime?
  status        String    @default("PENDING") // PENDING|PAID|EXPIRED|CANCELLED|FAILED
  rawPayload    String? // JSON string payload webhook terakhir
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  integration Integration?              @relation(fields: [integrationId], references: [id])
  customer    Customer                  @relation(fields: [customerId], references: [id])
  createdBy   User                      @relation("GatewayTxCreator", fields: [createdById], references: [id])
  invoices    PaymentGatewayTxInvoice[]
  payments    Payment[]

  @@index([status])
}

model PaymentGatewayTxInvoice {
  gatewayTxId String
  invoiceId   String

  gatewayTx PaymentGatewayTx @relation(fields: [gatewayTxId], references: [id])
  invoice   Invoice          @relation(fields: [invoiceId], references: [id])

  @@id([gatewayTxId, invoiceId])
}

// ═══════════════ Phase 10: Isolir & Dunning + MikroTik (DESIGN-PHASE-8 §4) ═══════════════
// Adaptasi: reminderOffsets CSV string & payload JSON string (SQLite tanpa
// scalar list/Json). Keputusan §11.4: kebijakan mendukung DUA ambang —
// hari lewat tempo dan jumlah tunggakan — mana yang lebih dulu tercapai.

model DunningPolicy {
  id                String  @id @default(cuid())
  name              String
  graceDays         Int     @default(0)
  reminderOffsets   String  @default("-3,0,3") // hari relatif jatuh tempo (CSV)
  isolateAfterDays  Int? // ambang: hari lewat jatuh tempo
  maxUnpaidInvoices Int? // ambang: jumlah invoice tertunggak
  isActive          Boolean @default(true)

  suspensions ServiceSuspension[]
}

// Isolir/pemulihan adalah EVENT bercatat, bukan kolom boolean (§0.3).
model ServiceSuspension {
  id             String    @id @default(cuid())
  subscriptionId String
  reason         String // OVERDUE|REQUEST|ABUSE|MAINTENANCE
  triggeredBy    String // SYSTEM|USER
  policyId       String?
  unpaidInvoices Int?
  unpaidAmount   BigInt?
  note           String?
  suspendedAt    DateTime  @default(now())
  restoredAt     DateTime?
  restoreNote    String?
  suspendJobId   String? // NetworkAccessJob DISABLE
  restoreJobId   String? // NetworkAccessJob ENABLE
  createdById    String? // null = evaluator sistem (cron)

  subscription Subscription   @relation(fields: [subscriptionId], references: [id])
  policy       DunningPolicy? @relation(fields: [policyId], references: [id])
  createdBy    User?          @relation("SuspensionCreator", fields: [createdById], references: [id])

  @@index([subscriptionId, suspendedAt])
  @@index([restoredAt])
}

// Antrian perintah ke router — auditable & retryable (§4). Isolir TIDAK
// pernah dieksekusi langsung dari UI ke router; kegagalan sync terlihat.
model NetworkAccessJob {
  id             String    @id @default(cuid())
  subscriptionId String?
  routerId       String? // NetworkDevice; null = belum tertaut → SKIPPED
  action         String // ENABLE|DISABLE|CREATE|UPDATE|DELETE|SYNC
  payload        String // JSON string (pppoeUsername, dsb.)
  status         String    @default("QUEUED") // QUEUED|RUNNING|SUCCESS|FAILED|SKIPPED
  attempts       Int       @default(0)
  lastError      String?
  executedAt     DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])
  router       NetworkDevice? @relation(fields: [routerId], references: [id])

  @@index([status, routerId])
}

// ═══════════════ Phase 11: General Ledger (DESIGN-PHASE-8 §5) ═══════════════
// Prinsip §0.2: uang tidak boleh punya dua sumber kebenaran — semua
// peristiwa keuangan menghasilkan SATU jurnal; laporan diturunkan dari
// jurnal. Jurnal append-only: koreksi = jurnal balik, tidak pernah edit.
// Adaptasi: taxPercent Float (SQLite tanpa Decimal).

model Account {
  id           String  @id @default(cuid())
  code         String  @unique // "1-10100" — gaya penomoran Accurate/Zahir (§7.1)
  name         String
  category     String // KAS_BANK|PIUTANG|...|PENDAPATAN|BEBAN (ACCOUNT_CATEGORIES)
  normalSide   String // DEBIT|CREDIT
  parentId     String?
  isTaxAccount Boolean @default(false)
  taxPercent   Float?
  cashbookId   String? @unique // jembatan ke Cashbook Fase 4 (§5: tanpa bongkar modul kas)
  isActive     Boolean @default(true)

  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")
  lines    JournalLine[]
  debitRules  PostingRule[] @relation("RuleDebit")
  creditRules PostingRule[] @relation("RuleCredit")

  @@index([category, isActive])
}

model JournalEntry {
  id           String    @id @default(cuid())
  entryNumber  String    @unique // JRN-YYYYMM-####
  entryDate    DateTime
  source       String // INVOICE|INVOICE_VOID|PAYMENT|COLLECTOR_FEE|CASH_TX|MANUAL|REVERSAL
  sourceId     String? // id entitas asal (tanpa FK — lintas modul)
  memo         String?
  partyType    String? // CUSTOMER|MERCHANT|EMPLOYEE|CONTACT
  partyId      String?
  status       String    @default("POSTED") // POSTED|REVERSED
  reversalOfId String?   @unique
  postedById   String? // null = diposting sistem (event billing/payment)
  createdAt    DateTime  @default(now())

  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversal   JournalEntry? @relation("JournalReversal")
  postedBy   User?         @relation("JournalPoster", fields: [postedById], references: [id])
  lines      JournalLine[]

  @@index([entryDate, source])
  @@index([source, sourceId])
}

model JournalLine {
  id           String  @id @default(cuid())
  entryId      String
  accountId    String
  debit        BigInt  @default(0)
  credit       BigInt  @default(0)
  description  String?
  costCenterId String?

  entry      JournalEntry @relation(fields: [entryId], references: [id])
  account    Account      @relation(fields: [accountId], references: [id])
  costCenter CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([accountId, entryId])
}

// Pemetaan peristiwa → akun — konfigurasi, bukan hardcode (§5).
// GL "aktif" ketika rule INVOICE_POSTED aktif ada; tanpa itu, modul
// billing/payment berjalan tanpa jurnal (perilaku pra-GL dipertahankan).
model PostingRule {
  id              String  @id @default(cuid())
  event           String  @unique // INVOICE_POSTED|INVOICE_TAX|PAYMENT_RECEIVED|COLLECTOR_FEE|GATEWAY_FEE
  debitAccountId  String?
  creditAccountId String?
  isActive        Boolean @default(true)

  debitAccount  Account? @relation("RuleDebit", fields: [debitAccountId], references: [id])
  creditAccount Account? @relation("RuleCredit", fields: [creditAccountId], references: [id])
}

// ═══════════════ Phase 12: Helpdesk Pelanggan & Dispatch (DESIGN-PHASE-8 §6) ═══════════════
// Adaptasi: tags CSV string (SQLite tanpa scalar list). Nilai tambah vs
// sistem lama: MTTR bersih dari jeda pause; tiket tersambung WorkOrder
// sehingga pemakaian material gudang ikut tercatat.

model TicketCategory {
  id         String  @id @default(cuid())
  name       String  @unique
  slaHours   Int?
  workflowId String?
  isActive   Boolean @default(true)

  workflow WorkflowTemplate? @relation(fields: [workflowId], references: [id])
  tickets  CustomerTicket[]
}

// Template workflow — dipakai tiket (dan lead, menyusul) (G17).
model WorkflowTemplate {
  id    String @id @default(cuid())
  kind  String @default("TICKET") // TICKET|LEAD
  name  String @unique
  steps WorkflowStep[]
  categories TicketCategory[]
}

model WorkflowStep {
  id          String  @id @default(cuid())
  templateId  String
  order       Int
  name        String
  description String?
  isRequired  Boolean @default(true)

  template WorkflowTemplate     @relation(fields: [templateId], references: [id])
  progress TicketStepProgress[]

  @@unique([templateId, order])
}

model CustomerTicket {
  id              String    @id @default(cuid())
  ticketNumber    String    @unique // CT-YYYYMM-####
  customerId      String
  subscriptionId  String?
  categoryId      String
  title           String
  description     String?
  status          String    @default("OPEN") // OPEN|IN_PROGRESS|PENDING|SOLVED|CLOSED
  priority        String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  tags            String? // CSV
  assigneeId      String?
  parentId        String? // sub-tiket (maks. 1 tingkat)
  scheduledAt     DateTime?
  latitude        Float?
  longitude       Float?
  resolution      String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  mttrMinutes     Int? // dihitung saat solve — BERSIH dari jeda pause
  slaBreached     Boolean   @default(false)
  workOrderId     String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id])
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id])
  category     TicketCategory       @relation(fields: [categoryId], references: [id])
  assignee     User?                @relation("CTicketAssignee", fields: [assigneeId], references: [id])
  parent       CustomerTicket?      @relation("SubTicket", fields: [parentId], references: [id])
  children     CustomerTicket[]     @relation("SubTicket")
  workOrder    WorkOrder?           @relation(fields: [workOrderId], references: [id])
  createdBy    User                 @relation("CTicketCreator", fields: [createdById], references: [id])
  members      TicketMember[]
  progress     TicketStepProgress[]
  pauses       TicketPause[]

  @@index([status, scheduledAt])
  @@index([assigneeId, status])
}

model TicketMember {
  ticketId String
  userId   String

  ticket CustomerTicket @relation(fields: [ticketId], references: [id])
  user   User           @relation("CTicketMember", fields: [userId], references: [id])

  @@id([ticketId, userId])
}

model TicketStepProgress {
  id       String    @id @default(cuid())
  ticketId String
  stepId   String
  doneAt   DateTime?
  doneById String?
  note     String?

  ticket CustomerTicket @relation(fields: [ticketId], references: [id])
  step   WorkflowStep   @relation(fields: [stepId], references: [id])
  doneBy User?          @relation("CTicketStepDoer", fields: [doneById], references: [id])

  @@unique([ticketId, stepId])
}

// "Hentikan Sementara" — MTTR berhenti dihitung selama jeda.
model TicketPause {
  id          String    @id @default(cuid())
  ticketId    String
  reason      String
  pausedAt    DateTime  @default(now())
  resumedAt   DateTime?
  createdById String

  ticket    CustomerTicket @relation(fields: [ticketId], references: [id])
  createdBy User           @relation("CTicketPauser", fields: [createdById], references: [id])

  @@index([ticketId, resumedAt])
}

// ═══════════════ Phase 13: FTTH Port Management (DESIGN-PHASE-8 §7) ═══════════════
// Perluasan model NOC — bukan paralel. Perbaikan atas sistem lama:
// OdpPort per-port (diketahui port berapa dipakai pelanggan mana);
// portUsed = turunan yang dijaga konsisten oleh engine, bukan angka lepas.
// Kredensial OLT TIDAK plaintext — credentialRef = nama env var (rule 31).

model OltDevice {
  id              String  @id @default(cuid())
  networkDeviceId String  @unique // spesialisasi NetworkDevice bertipe OLT
  vendor          String // ZTE|HUAWEI|CDATA|HSGQ|FIBERHOME|VSOL|HIOSO
  model           String?
  managementIp    String
  telnetPort      Int?
  snmpPort        Int?
  credentialRef   String? // nama env var — bukan secret
  notes           String?

  networkDevice NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  ponPorts      PonPort[]
}

// Padanan "Dist Group" sistem lama: port PON pada OLT (mis. "1/2/1").
model PonPort {
  id    String @id @default(cuid())
  oltId String
  slot  Int
  port  Int
  label String

  olt  OltDevice @relation(fields: [oltId], references: [id])
  odps Odp[]

  @@unique([oltId, slot, port])
}

model Odp {
  id            String  @id @default(cuid())
  code          String  @unique
  siteId        String?
  ponPortId     String?
  parentId      String? // ODP kaskade
  portCapacity  Int
  portUsed      Int     @default(0) // turunan — direkap engine, selalu konsisten
  opticPowerDbm Float?
  latitude      Float?
  longitude     Float?
  status        String  @default("ACTIVE") // ACTIVE|INACTIVE|PLANNED
  notes         String?

  site     NetworkSite? @relation(fields: [siteId], references: [id])
  ponPort  PonPort?     @relation(fields: [ponPortId], references: [id])
  parent   Odp?         @relation("OdpTree", fields: [parentId], references: [id])
  children Odp[]        @relation("OdpTree")
  ports    OdpPort[]
}

// Yang TIDAK dimiliki sistem lama: pemetaan per-port → pelanggan.
model OdpPort {
  id             String  @id @default(cuid())
  odpId          String
  portNumber     Int
  subscriptionId String? @unique // satu langganan satu port
  status         String  @default("FREE") // FREE|USED|RESERVED|DAMAGED
  note           String?

  odp          Odp           @relation(fields: [odpId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([odpId, portNumber])
}

// ═══════════════ Phase 14: HRD & Absensi (DESIGN-PHASE-8 §8) ═══════════════
// Keunggulan vs sistem lama: izin & lembur memakai ApprovalRule yang sudah
// ada sehingga bisa BERJENJANG (atasan → HRD), bukan satu tingkat.
// Adaptasi: jam shift disimpan "HH:MM" (SQLite tanpa tipe Time); tanggal
// memakai DateTime dinormalkan ke tengah malam.

model Employee {
  id           String   @id @default(cuid())
  userId       String?  @unique // tertaut akun sistem bila ada
  employeeNo   String   @unique
  fullName     String
  jobTitle     String?
  employeeType String   @default("FULL_TIME") // FULL_TIME|PART_TIME|CONTRACT|PROBATION
  supervisorId String?
  joinedAt     DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User?              @relation("EmployeeUser", fields: [userId], references: [id])
  supervisor  Employee?          @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[]        @relation("EmployeeSupervisor")
  schedules   ShiftSchedule[]
  attendances Attendance[]
  leaves      LeaveRequest[]
  overtimes   OvertimeRequest[]

  @@index([isActive])
}

model AttendanceLocation {
  id        String  @id @default(cuid())
  name      String  @unique
  latitude  Float
  longitude Float
  radiusM   Int     @default(100)
  isActive  Boolean @default(true)

  attendances Attendance[]
}

model Shift {
  id               String  @id @default(cuid())
  name             String  @unique
  startTime        String // "08:00"
  endTime          String // "17:00"
  lateToleranceMin Int     @default(0)
  isActive         Boolean @default(true)

  schedules   ShiftSchedule[]
  attendances Attendance[]
}

model ShiftSchedule {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  shiftId    String?
  dayType    String   @default("WORK") // WORK|OFF|HOLIDAY
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
}

model Attendance {
  id                String    @id @default(cuid())
  employeeId        String
  date              DateTime
  shiftId           String?
  clockInAt         DateTime?
  clockInLocationId String?
  clockInDistanceM  Int?
  clockInPhotoId    String? // Attachment (foto selfie)
  clockOutAt        DateTime?
  clockOutPhotoId   String?
  lateMinutes       Int       @default(0)
  workMinutes       Int       @default(0)
  status            String    @default("PRESENT") // PRESENT|LATE|ABSENT|LEAVE|SICK|HOLIDAY
  note              String?

  employee       Employee            @relation(fields: [employeeId], references: [id])
  shift          Shift?              @relation(fields: [shiftId], references: [id])
  clockInLocation AttendanceLocation? @relation(fields: [clockInLocationId], references: [id])

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id                String   @id @default(cuid())
  requestNumber     String   @unique // LVE-YYYYMM-####
  employeeId        String
  type              String // ANNUAL|SICK|OTHER
  startDate         DateTime
  endDate           DateTime
  days              Int
  reason            String
  attachmentId      String?
  approvalRequestId String?  @unique // ← approval engine berjenjang
  status            String   @default("PENDING") // PENDING|APPROVED|REJECTED|CANCELLED
  createdAt         DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

model OvertimeRequest {
  id                String   @id @default(cuid())
  requestNumber     String   @unique // OVT-YYYYMM-####
  employeeId        String
  date              DateTime
  startTime         String // "18:00"
  endTime           String // "21:00"
  minutes           Int
  reason            String
  approvalRequestId String?  @unique
  status            String   @default("PENDING") // PENDING|APPROVED|REJECTED|CANCELLED
  createdAt         DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

// ═══════════════ Phase 15: Kanal Pelanggan (DESIGN-PHASE-8 §9) ═══════════════
// WA gateway sebagai adapter Integration (bukan modul terpisah): template
// pesan, antrian kirim, status terkirim/gagal, dan rate limit. Adapter
// pengirim live menunggu kredensial gateway (§11.7) — executor pluggable
// seperti NetworkAccessJob Fase 10.

model MessageTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  channel   String // WHATSAPP|EMAIL|APP|IN_APP
  subject   String? // untuk EMAIL
  body      String // mendukung placeholder {{nama}}, {{nomor}}, dst.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages OutboundMessage[]
}

model OutboundMessage {
  id            String    @id @default(cuid())
  templateId    String?
  integrationId String? // adapter pengirim (WA gateway, SMTP)
  customerId    String?
  channel       String // WHATSAPP|EMAIL|APP
  recipient     String // nomor / email tujuan
  subject       String?
  body          String
  status        String    @default("QUEUED") // QUEUED|SENDING|SENT|FAILED|SKIPPED
  attempts      Int       @default(0)
  lastError     String?
  sentAt        DateTime?
  relatedType   String? // Invoice|CustomerTicket|Incident|Announcement
  relatedId     String?
  createdById   String?
  createdAt     DateTime  @default(now())

  template    MessageTemplate? @relation(fields: [templateId], references: [id])
  integration Integration?     @relation(fields: [integrationId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  createdBy   User?            @relation("OutboundCreator", fields: [createdById], references: [id])

  @@index([status, channel])
  @@index([customerId, createdAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  badge       String? // "PROMO", "INFO", dst.
  body        String
  startAt     DateTime
  endAt       DateTime?
  isPublished Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([isPublished, startAt])
}

/// Penomoran dokumen atomik per (tipe, periode) — Fase 16 (PRD-WAREHOUSE-ENHANCEMENT F4).
/// Menggantikan pola count()+1 yang tidak aman saat dua proses berjalan bersamaan.
/// Nomor diambil di dalam transaksi lewat lib/documents.ts.
model DocumentSequence {
  id         String   @id @default(cuid())
  docType    String // INV | GR | ISS | RET | TRF | ADJ | OPN | DO | IRF | STO | RCV
  periodKey  String // "202608" (bulanan) atau "20260810" (harian)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([docType, periodKey])
}

/// Penerimaan transfer antar gudang — Fase 17 (PRD-WAREHOUSE-ENHANCEMENT F3).
/// Satu transfer bisa punya beberapa penerimaan (penerimaan bertahap), sehingga
/// barang tidak pernah hilang dari pembukuan: selalu ada di gudang asal,
/// perjalanan (inTransit), atau gudang tujuan.
model TransferReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique // RCV-YYYYMM-####
  txId          String
  receivedById  String
  receivedAt    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  tx         StockTransaction      @relation(fields: [txId], references: [id])
  receivedBy User                  @relation("TransferReceiver", fields: [receivedById], references: [id])
  lines      TransferReceiptLine[]

  @@index([txId])
}

model TransferReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  txLineId  String
  itemId    String
  qty       Int
  deviceId  String?

  receipt TransferReceipt      @relation(fields: [receiptId], references: [id])
  txLine  StockTransactionLine @relation(fields: [txLineId], references: [id])
  item    Item                 @relation(fields: [itemId], references: [id])

  @@index([receiptId])
  @@index([txLineId])
}

/// Fase 18 (PRD-WAREHOUSE-ENHANCEMENT F5) — surat jalan atas transaksi
/// pengeluaran/transfer. Maksimal satu DO aktif per transaksi.
model DeliveryOrder {
  id          String    @id @default(cuid())
  doNumber    String    @unique // DO-YYYYMM-####
  txId        String
  status      String    @default("DRAFT") // DRAFT|APPROVED|CANCELLED
  notes       String?
  createdById String
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())

  tx         StockTransaction    @relation(fields: [txId], references: [id])
  createdBy  User                @relation("DoCreator", fields: [createdById], references: [id])
  approvedBy User?               @relation("DoApprover", fields: [approvedById], references: [id])
  lines      DeliveryOrderLine[]

  @@index([txId, status])
}

model DeliveryOrderLine {
  id       String @id @default(cuid())
  doId     String
  txLineId String
  itemId   String
  qty      Int

  deliveryOrder DeliveryOrder        @relation(fields: [doId], references: [id])
  txLine        StockTransactionLine @relation(fields: [txLineId], references: [id])
  item          Item                 @relation(fields: [itemId], references: [id])

  @@index([doId])
}

/// Fase 18 (F6) — Inventory Request Form: satu IRF per sesi pengeluaran barang,
/// dibuat otomatis saat posting dan wajib memuat dua tanda tangan.
model InventoryRequestForm {
  id          String   @id @default(cuid())
  irfNumber   String   @unique // IRF-YYYYMM-####
  txId        String   @unique
  status      String   @default("SIGNED") // DRAFT|SIGNED|CANCELLED
  createdById String
  createdAt   DateTime @default(now())

  tx        StockTransaction @relation(fields: [txId], references: [id])
  createdBy User             @relation("IrfCreator", fields: [createdById], references: [id])
}

/// Tanda tangan dokumen — diambil SEBELUM transaksi database dijalankan,
/// sehingga tidak pernah ada tanda tangan yatim yang seolah mengesahkan
/// serah-terima yang tidak terjadi.
model DocumentSignature {
  id           String   @id @default(cuid())
  docType      String // IRF|DO|RECEIPT
  docId        String
  role         String // REQUESTOR|WAREHOUSE_ADMIN|RECEIVED_BY|RELEASED_BY
  signerName   String
  signerUserId String?
  attachmentId String? // gambar tanda tangan (model Attachment)
  signedAt     DateTime @default(now())

  signerUser User?       @relation("SignatureSigner", fields: [signerUserId], references: [id])
  attachment Attachment? @relation(fields: [attachmentId], references: [id])

  @@unique([docType, docId, role])
  @@index([docType, docId])
}

/// Fase 18 (F8) — pengajuan pengembalian material oleh pemegang barang.
/// Jalur kedua (verifikasi admin) menghasilkan transaksi STOCK_RETURN.
model ReturnRequest {
  id            String    @id @default(cuid())
  returnNumber  String    @unique // RET-YYYYMM-####
  requesterId   String
  warehouseToId String
  status        String    @default("PENDING") // PENDING|ACCEPTED|REJECTED
  note          String?
  verifiedById  String?
  verifiedAt    DateTime?
  verifyNote    String?
  txId          String?   @unique
  createdAt     DateTime  @default(now())

  requester   User                @relation("ReturnRequester", fields: [requesterId], references: [id])
  warehouseTo Warehouse           @relation("ReturnWarehouse", fields: [warehouseToId], references: [id])
  verifiedBy  User?               @relation("ReturnVerifier", fields: [verifiedById], references: [id])
  tx          StockTransaction?   @relation(fields: [txId], references: [id])
  lines       ReturnRequestLine[]

  @@index([status])
}

model ReturnRequestLine {
  id        String  @id @default(cuid())
  requestId String
  itemId    String
  qty       Int
  deviceId  String?
  condition String // GOOD|USED|DAMAGED|RMA

  request ReturnRequest     @relation(fields: [requestId], references: [id])
  item    Item              @relation(fields: [itemId], references: [id])
  device  SerializedDevice? @relation(fields: [deviceId], references: [id])

  @@index([requestId])
}

/// Fase 19 (PRD-WAREHOUSE-ENHANCEMENT F7) — permintaan material yang diajukan
/// sendiri oleh teknisi/vendor/tim proyek dari lapangan. Persetujuan
/// menghasilkan draft pengeluaran resmi yang langsung mereservasi stock.
model MaterialRequest {
  id           String    @id @default(cuid())
  requestNumber String   @unique // MRQ-YYYYMM-####
  requesterId  String
  warehouseId  String
  workOrderId  String?
  purpose      String
  note         String?
  status       String    @default("SUBMITTED") // SUBMITTED|APPROVED|REJECTED|CANCELLED
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  txId         String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester User              @relation("MrqRequester", fields: [requesterId], references: [id])
  warehouse Warehouse         @relation("MrqWarehouse", fields: [warehouseId], references: [id])
  workOrder WorkOrder?        @relation(fields: [workOrderId], references: [id])
  decidedBy User?             @relation("MrqDecider", fields: [decidedById], references: [id])
  tx        StockTransaction? @relation(fields: [txId], references: [id])
  lines     MaterialRequestLine[]

  @@index([status, requesterId])
}

model MaterialRequestLine {
  id        String @id @default(cuid())
  requestId String
  itemId    String
  qty       Int
  note      String?

  request MaterialRequest @relation(fields: [requestId], references: [id])
  item    Item            @relation(fields: [itemId], references: [id])

  @@index([requestId])
}

/// Fase 20 (F10) — lokasi fisik dalam gudang: rak lalu bin.
model Rack {
  id          String  @id @default(cuid())
  warehouseId String
  code        String
  name        String?
  isActive    Boolean @default(true)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bins      Bin[]

  @@unique([warehouseId, code])
}

model Bin {
  id       String  @id @default(cuid())
  rackId   String
  code     String
  isActive Boolean @default(true)

  rack Rack @relation(fields: [rackId], references: [id])

  @@unique([rackId, code])
}

/// Fase 20 (F9) — slot peruntukan stock. UNALLOC bersifat sistem: sisa yang
/// belum dialokasikan dihitung sebagai onHand dikurangi seluruh alokasi
/// bernama, jadi tidak pernah bisa menyimpang dari saldo gudang.
model StockSlotType {
  id       String  @id @default(cuid())
  code     String  @unique // INST|MNT|MKT|PRJ|EMG|SPR|RMA|DEMO|OTHER
  name     String
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  slots StockSlot[]
}

model StockSlot {
  id          String  @id @default(cuid())
  warehouseId String
  typeId      String
  code        String
  name        String?
  isActive    Boolean @default(true)

  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  type        StockSlotType    @relation(fields: [typeId], references: [id])
  allocations SlotAllocation[]
  ledger      SlotLedger[]

  @@unique([warehouseId, code])
}

/// Saldo alokasi per (slot × item). Total alokasi seluruh slot dalam satu
/// gudang tidak boleh melebihi onHand item tersebut.
model SlotAllocation {
  id     String @id @default(cuid())
  slotId String
  itemId String
  qty    Int    @default(0)

  slot StockSlot @relation(fields: [slotId], references: [id])
  item Item      @relation(fields: [itemId], references: [id])

  @@unique([slotId, itemId])
}

/// Jejak mutasi alokasi — append-only, tidak pernah diedit.
model SlotLedger {
  id          String   @id @default(cuid())
  slotId      String
  itemId      String
  qty         Int // bertanda: positif masuk slot, negatif keluar slot
  reason      String // ALLOCATE|RELEASE|SLOT_TRANSFER
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  slot      StockSlot @relation(fields: [slotId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  createdBy User      @relation("SlotLedgerCreator", fields: [createdById], references: [id])

  @@index([slotId, itemId])
}

/// Ambang nilai/jumlah yang membuat perpindahan slot butuh persetujuan.
model SlotTransferPolicy {
  id        String  @id @default(cuid())
  name      String
  maxQty    Int // di atas ini butuh izin slot.approve
  isActive  Boolean @default(true)
}

/// Fase 21 (F12) — pembatasan gudang untuk seorang user. Bila user punya
/// setidaknya satu baris, ia hanya boleh menyentuh gudang yang terdaftar.
model UserWarehouseScope {
  id          String @id @default(cuid())
  userId      String
  warehouseId String

  user      User      @relation("WarehouseScopeUser", fields: [userId], references: [id])
  warehouse Warehouse @relation("WarehouseScope", fields: [warehouseId], references: [id])

  @@unique([userId, warehouseId])
}

/// Fase 24 (PRD-NOC-TOOLS N2) — router MikroTik sebagai spesialisasi
/// NetworkDevice, mengikuti pola OltDevice. RouterOS v7 → REST API di atas
/// HTTPS, jadi tidak butuh pustaka klien tambahan.
model MikrotikRouter {
  id              String   @id @default(cuid())
  networkDeviceId String   @unique
  managementUrl   String // https://host[:port]
  /// Nama env var berisi "user:password" — BUKAN nilainya (pola Fase 13).
  credentialRef   String
  pollIntervalSec Int      @default(60)
  isPollingEnabled Boolean @default(true)
  lastPolledAt    DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  networkDevice NetworkDevice  @relation(fields: [networkDeviceId], references: [id])
  sessions      PppoeSession[]
  pollRuns      PppoePollRun[]
}

/// Keadaan sesi PPPoE terakhir yang diketahui per (router × username).
/// Diisi HANYA oleh poller — halaman monitor tidak pernah menulis ke sini.
model PppoeSession {
  id             String   @id @default(cuid())
  routerId       String
  subscriptionId String?
  username       String
  callerId       String? // MAC
  address        String? // IP yang diberikan
  uptimeSeconds  Int?
  status         String // ONLINE|OFFLINE|DISABLED
  lastSeenAt     DateTime?
  updatedAt      DateTime @updatedAt

  router       MikrotikRouter @relation(fields: [routerId], references: [id])
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])

  @@unique([routerId, username])
  @@index([status])
}

/// Jejak setiap penarikan data. Kegagalan polling adalah STATE yang terlihat,
/// bukan log yang tenggelam.
model PppoePollRun {
  id            String    @id @default(cuid())
  routerId      String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    @default("RUNNING") // RUNNING|SUCCESS|FAILED
  totalCount    Int       @default(0)
  onlineCount   Int       @default(0)
  offlineCount  Int       @default(0)
  disabledCount Int       @default(0)
  matchedCount  Int       @default(0) // username yang cocok ke langganan
  error         String?

  router MikrotikRouter @relation(fields: [routerId], references: [id])

  @@index([routerId, startedAt])
}

/// Fase 25 (PRD-NOC-TOOLS N3) — target monitoring realtime.
///
/// Metode TCP connect dipilih sebagai default karena ICMP butuh raw socket
/// (hak root) yang tidak tersedia di proses aplikasi. TCP connect mengukur
/// keterjangkauan DAN latensi tanpa hak khusus, dan hasilnya deterministik.
model ProbeTarget {
  id              String  @id @default(cuid())
  name            String
  address         String // IP atau hostname
  method          String  @default("TCP") // TCP (ICMP menyusul bila ada worker berhak)
  port            Int     @default(443)
  kind            String  @default("DEVICE") // DEVICE|SITE|UPSTREAM
  networkDeviceId String?
  siteId          String?
  severity        String  @default("MAJOR") // severity alarm saat DOWN
  intervalSec     Int     @default(60)
  timeoutMs       Int     @default(3000)
  /// Berapa kali gagal berturut-turut sebelum alarm dinaikkan. Mencegah
  /// satu paket hilang langsung membangunkan orang.
  failThreshold   Int     @default(3)
  isActive        Boolean @default(true)

  consecutiveFails Int      @default(0)
  lastStatus       String? // UP|DOWN
  lastLatencyMs    Int?
  lastCheckedAt    DateTime?
  /// Alarm yang sedang terbuka akibat target ini — dipakai untuk auto-clear.
  openAlarmId      String?
  createdAt        DateTime @default(now())

  networkDevice NetworkDevice? @relation(fields: [networkDeviceId], references: [id])
  site          NetworkSite?   @relation(fields: [siteId], references: [id])
  results       ProbeResult[]

  @@index([isActive, lastStatus])
}

/// Hasil tiap pemeriksaan — append-only, dipangkas berkala oleh worker.
model ProbeResult {
  id        String   @id @default(cuid())
  targetId  String
  checkedAt DateTime @default(now())
  status    String // UP|DOWN
  latencyMs Int?
  error     String?

  target ProbeTarget @relation(fields: [targetId], references: [id])

  @@index([targetId, checkedAt])
}

/// Fase 27 — pekerjaan berkala. Sebelum ini seluruh mesin (probe, poller PPPoE,
/// antrian pesan, antrian isolir, evaluasi dunning) hanya berjalan bila ada
/// orang menekan tombol. Sistemnya utuh tapi pasif.
///
/// Kunci sewa (lockedAt/lockedBy) mencegah dua worker menjalankan pekerjaan
/// yang sama bersamaan — direbut lewat satu UPDATE bersyarat, bukan baca-lalu-
/// tulis, sehingga aman terhadap balapan.
model ScheduledTask {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  intervalSec Int
  isEnabled   Boolean   @default(true)

  lastRunAt      DateTime?
  lastStatus     String? // SUCCESS|FAILED
  lastError      String?
  lastDurationMs Int?
  runCount       Int      @default(0)
  failCount      Int      @default(0)

  /// Sewa: diisi saat pekerjaan direbut, dikosongkan saat selesai. Sewa yang
  /// kedaluwarsa boleh direbut worker lain — supaya worker yang mati tidak
  /// mengunci pekerjaan selamanya.
  lockedAt  DateTime?
  lockedBy  String?

  createdAt DateTime @default(now())
  runs      ScheduledTaskRun[]

  @@index([isEnabled, lastRunAt])
}

model ScheduledTaskRun {
  id         String    @id @default(cuid())
  taskId     String
  workerId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING|SUCCESS|FAILED
  detail     String?
  error      String?

  task ScheduledTask @relation(fields: [taskId], references: [id])

  @@index([taskId, startedAt])
}

/// Fase 28 (PRD terminasi §11) — ambang SLA dan minimal percobaan sebelum
/// perangkat boleh dinyatakan tidak kembali. Disimpan sebagai data, bukan
/// konstanta di kode, karena §22 Q-003 masih terbuka soal SLA per wilayah.
model DeviceRecoverySetting {
  id          String   @id @default(cuid())
  name        String   @default("Default")
  slaDays     Int      @default(7)
  minAttempts Int      @default(3)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ═══════ Fase 29–32: Terminasi Pelanggan & Recovery Perangkat ═══════
// Sumber: PRD-terminasi-pelanggan-dan-recovery-perangkat.md
//
// Menempel pada mesin yang sudah ada, bukan membangun ulang:
//  - penomoran lewat DocumentSequence (Fase 16), bukan count()+1
//  - persetujuan lewat ApprovalRequest (Fase 1) beserta SoD-nya
//  - penarikan lewat WorkOrder tipe DEVICE_RETRIEVAL yang SUDAH ada
//  - bukti & tanda tangan lewat Attachment + DocumentSignature (Fase 18)
//  - seluruh mutasi stok lewat StockTransaction yang diposting (Fase 3/16)

model CustomerTermination {
  id                String    @id @default(cuid())
  terminationNumber String    @unique // TRM-YYYYMM-####
  customerId        String
  subscriptionId    String
  reason            String
  reasonCategory    String    @default("CUSTOMER_REQUEST") // CUSTOMER_REQUEST|NON_PAYMENT|RELOCATION|FRAUD|OTHER
  effectiveDate     DateTime
  warehouseToId     String // gudang penerima hasil penarikan
  status            String    @default("DRAFT") // DRAFT|SUBMITTED|APPROVED|EFFECTIVE|REJECTED|CANCELLED
  /// Snapshot §11.2 — potret pelanggan, layanan, jaringan, dan perangkat pada
  /// saat pengajuan. Sengaja disimpan utuh: master data boleh berubah, berita
  /// acara tidak boleh ikut berubah setelah ditandatangani.
  snapshot          Json?
  approvalRequestId String?   @unique
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  cancelReason      String?
  effectiveAt       DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id])
  subscription Subscription         @relation(fields: [subscriptionId], references: [id])
  warehouseTo  Warehouse            @relation("TerminationWarehouse", fields: [warehouseToId], references: [id])
  createdBy    User                 @relation("TerminationCreator", fields: [createdById], references: [id])
  decidedBy    User?                @relation("TerminationDecider", fields: [decidedById], references: [id])
  recovery     DeviceRecoveryIssue?

  @@index([status, effectiveDate])
  @@index([customerId])
}

model DeviceRecoveryIssue {
  id             String @id @default(cuid())
  recoveryNumber String @unique // DRI-YYYYMM-####
  terminationId  String @unique
  workOrderId    String @unique
  warehouseToId  String
  status         String @default("OPEN") // OPEN|ASSIGNED|IN_PROGRESS|PARTIAL|RECOVERED|INSPECTION|COMPLETED|CLOSED_UNRECOVERED
  assigneeId     String?
  scheduledAt    DateTime?
  slaDueAt       DateTime?
  /// Gerbang §13.5 — port ODP hanya boleh dilepas setelah pemutusan fisik
  /// dikonfirmasi. Tanpa ini, port bisa dijual ke pelanggan lain padahal
  /// kabelnya masih tersambung.
  physicalDisconnectedAt   DateTime?
  physicalDisconnectedById String?
  completedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  termination CustomerTermination     @relation(fields: [terminationId], references: [id])
  workOrder   WorkOrder               @relation(fields: [workOrderId], references: [id])
  warehouseTo Warehouse               @relation("RecoveryWarehouse", fields: [warehouseToId], references: [id])
  assignee    User?                   @relation("RecoveryAssignee", fields: [assigneeId], references: [id])
  items       DeviceRecoveryItem[]
  attempts    DeviceRecoveryAttempt[]

  @@index([status, slaDueAt])
}

model DeviceRecoveryItem {
  id         String @id @default(cuid())
  recoveryId String
  deviceId   String
  /// Snapshot saat pengajuan — pembanding untuk mendeteksi perangkat tertukar
  /// di lapangan (§13.4). Tidak ikut berubah bila master data diperbarui.
  snapshotSerial   String
  snapshotMac      String?
  snapshotItemName String
  actualSerial     String?
  actualMac        String?
  mismatchNote     String? // wajib bila actual ≠ snapshot
  status           String  @default("RECOVERY_PENDING") // RECOVERY_PENDING|PICKED_UP|RECEIVED|INSPECTED|NOT_RETURNED
  finalDecision    String? // LAYAK_DIGUNAKAN|PERLU_PERBAIKAN|RUSAK|SCRAP|TIDAK_KEMBALI
  pickedUpAt       DateTime?
  receivedAt       DateTime?
  receivedById     String?
  notReturnedNote  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recovery   DeviceRecoveryIssue @relation(fields: [recoveryId], references: [id])
  device     SerializedDevice    @relation(fields: [deviceId], references: [id])
  receivedBy User?               @relation("RecoveryReceiver", fields: [receivedById], references: [id])
  inspection DeviceInspection?

  @@unique([recoveryId, deviceId])
  @@index([status])
  @@index([deviceId])
}

model DeviceRecoveryAttempt {
  id         String   @id @default(cuid())
  recoveryId String
  attemptAt  DateTime @default(now())
  result     String // BERHASIL|TIDAK_DI_TEMPAT|DITOLAK|GAGAL_LAIN
  note       String?
  latitude   Float?
  longitude  Float?
  byUserId   String

  recovery DeviceRecoveryIssue @relation(fields: [recoveryId], references: [id])
  byUser   User                @relation("RecoveryAttemptUser", fields: [byUserId], references: [id])

  @@index([recoveryId, attemptAt])
}

model DeviceInspection {
  id          String   @id @default(cuid())
  itemId      String   @unique // DeviceRecoveryItem
  /// Checklist §13.7 — casing, boot, reset, LAN, WiFi, optical, aksesori.
  /// Json supaya butir pemeriksaan bisa bertambah tanpa migrasi.
  checklist   Json
  decision    String // LAYAK_DIGUNAKAN|PERLU_PERBAIKAN|RUSAK|SCRAP
  note        String
  inspectorId String
  inspectedAt DateTime @default(now())

  item      DeviceRecoveryItem @relation(fields: [itemId], references: [id])
  inspector User               @relation("DeviceInspector", fields: [inspectorId], references: [id])
}
