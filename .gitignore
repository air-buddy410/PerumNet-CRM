# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env
.env
# SEMUA turunan .env, bukan cuma .local — cadangan seperti
# ".env.cadangan-sebelum-mailserver" memuat SESSION_SECRET, OIDC_CLIENT_SECRET,
# AUTHENTIK_API_TOKEN, dan MAILCOW_API_KEY. Sebelum ini berkas semacam itu
# muncul sebagai untracked biasa, dan satu `git add -A` dari agen mana pun
# sudah cukup mengirimnya ke GitHub.
.env.*
!.env.example

# database (dev)
prisma/*.db
prisma/*.db-journal

# typescript
*.tsbuildinfo

# uploads (bukti/lampiran — di luar git)
/uploads/

# direktori build terpisah antar-proses (NEXT_DIST_DIR)
.next-*

# Berkas kunci sementara Excel — muncul saat template dibuka, bukan bagian repo.
~$*

# Template HRD yang SUDAH DIISI data pegawai sungguhan — alamat rumah, email,
# tanggal lahir, golongan darah. Berkas kosongnya memang di-commit; yang terisi
# tidak pernah. Sekali masuk riwayat git, ia tidak bisa benar-benar dihapus.
docs/template/*-TERISI.xlsx

# Panenan data pribadi dari sistem lama — NIK, KTP, tanggal lahir.
# JANGAN pernah masuk git: riwayat git itu permanen dan terdorong ke GitHub,
# jadi satu commit yang salah tidak bisa ditarik kembali dengan sungguhan.
# Berkas seperti ini dipindahkan ke server lewat scp, bukan lewat repo.
data/nik-*.tsv
data/*-pii-*.tsv
data/panen-*.tsv
