# ── PerumNet CRM — contoh konfigurasi ───────────────────────────
#
# Salin menjadi `.env`, lalu isi nilainya. Berkas `.env` TIDAK dilacak git.
#
# Aturan yang dipegang seluruh proyek ini: RAHASIA TIDAK PERNAH MASUK
# DATABASE. Yang tersimpan di tabel Integration/MikrotikRouter hanyalah NAMA
# environment variable-nya (kolom `credentialRef`); nilainya dibaca dari
# berkas ini. Lihat bagian "Kredensial perangkat & layanan" di bawah.


# ── Wajib ───────────────────────────────────────────────────────

# PostgreSQL. Dev memakai container Docker `perumnet-postgres` di port 5433.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/perumnet_dev?schema=public"

# Kunci penanda tangan sesi (JWT). Acak dan panjang — ganti untuk tiap
# lingkungan. Mengubahnya akan mengeluarkan semua orang dari sesinya.
#   Membuat nilai baru:  openssl rand -base64 48
SESSION_SECRET="ganti-dengan-nilai-acak-panjang"

# Alamat CRM yang dilihat peramban. Dipakai menyusun redirect URI OIDC dan
# tautan absolut. Tanpa garis miring di akhir.
APP_URL="http://localhost:3300"


# ── Autentikasi ─────────────────────────────────────────────────
#
# LOCAL      — password disimpan di CRM sebagai hash bcrypt. Ganti password
#              bekerja sungguhan. Ini bawaannya.
# OIDC       — masuk lewat penyedia identitas (Authentik). CRM tidak pernah
#              memegang passwordnya, jadi ganti password ditutup — di UI
#              MAUPUN di server.
# MAILSERVER — sama seperti OIDC dari sudut pandang UI: bukan milik CRM.
#
# PERINGATAN sebelum mengubah ke OIDC: password lokal akan ditolak untuk SEMUA
# akun kecuali yang ditandai "Akun Darurat" di /settings/users/<id>. Tandai
# minimal satu akun LEBIH DULU — kalau tidak, penyedia identitas yang bermasalah
# mengunci semua orang dari CRM, termasuk dari memperbaikinya.
AUTH_PROVIDER="LOCAL"

# Diisi hanya bila AUTH_PROVIDER="OIDC".
# Ketiganya ada di Authentik → Applications → Providers → provider CRM.
# Issuer HARUS berakhiran garis miring, persis seperti yang ditampilkan di sana.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# Satu-satunya rahasia OIDC. TIDAK pernah dipakai memverifikasi token —
# verifikasi memakai kunci publik dari JWKS (RS256) — hanya untuk menukar kode.
OIDC_CLIENT_SECRET=""


# ── Kredensial perangkat & layanan ──────────────────────────────
#
# Router MikroTik dan mailserver mailcow tidak menyimpan rahasianya di
# database. Yang tersimpan di sana adalah NAMA variabel di bawah, dan namanya
# kamu tentukan sendiri saat mendaftarkan perangkat/integrasi.
#
# MikroTik — berbentuk "user:password":
# MIKROTIK_POP1_CRED="admin:password-router"
#
# mailcow — API key apa adanya:
# MAILCOW_API_KEY="api-key-dari-mailcow"

# Melewati verifikasi sertifikat TLS ke router. RouterOS biasanya memakai
# sertifikat buatan sendiri dan Node menolaknya.
#
# Menyalakannya berarti koneksi bisa disadap atau dibajak di tengah jalan,
# jadi ini MATI secara default. Jalan yang benar tetap memasang sertifikat
# tepercaya di router; opsi ini untuk jaringan manajemen tertutup, bukan untuk
# kenyamanan. Isi "1" untuk menyalakan.
MIKROTIK_INSECURE_TLS=""


# ── Opsional ────────────────────────────────────────────────────

# Sumber tile peta di halaman NOC. Kosong = memakai bawaan.
NEXT_PUBLIC_MAP_STYLE_URL=""

# Jeda antar-putaran worker (`npm run worker`), dalam milidetik.
# Kosong = bawaan.
WORKER_TICK_MS=""


# ── Hanya untuk skrip pendaftaran router ────────────────────────
# Tidak perlu ada di .env; dikirim sekali saat menjalankan skripnya:
#   ROUTER_HOST=perumnet-pop1 ROUTER_URL=https://10.0.0.1 \
#   ROUTER_SITE=POP1 ROUTER_CRED_ENV=MIKROTIK_POP1_CRED \
#   npx tsx scripts/register-router.ts


# ── Catatan tentang database tes ────────────────────────────────
# `npm run test:integration` TIDAK memakai DATABASE_URL di atas. Ia menurunkan
# sendiri URL database tes terpisah (perumnet_test) dari nilai itu, lalu
# membuatnya bila belum ada. Tidak ada variabel tambahan yang perlu diisi, dan
# data dev tidak pernah tersentuh oleh tes.
